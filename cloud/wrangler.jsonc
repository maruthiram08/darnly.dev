// Darnly cloud: the cloud inbox API (and, from sprint A3, the MCP endpoint).
// Production resources (created 2026-11-01): D1 "darnly", R2 "darnly-bugs", KV "OAUTH_KV". See DEPLOY.md.
{
  "name": "darnly-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "darnly", "database_id": "b1f3a2eb-5658-4a44-b872-1ac043e3afc4", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "darnly-bugs" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "2a549817cf404a31a65609b3a5e47800" }],
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "PUBLIC_URL": "https://api.darnly.dev",
    // OAuth client id of type "Chrome extension" from Google Cloud Console. Tokens for any other client are refused.
    "GOOGLE_EXTENSION_CLIENT_ID": "707818170740-n9bp4nmkrt8avl5p29452d59cve587as.apps.googleusercontent.com",
    // OAuth client id of type "Web application" for agent sign-in. Its secret is set with `wrangler secret put GOOGLE_WEB_CLIENT_SECRET`.
    "GOOGLE_WEB_CLIENT_ID": "707818170740-qvuscm010h8l15ldp5ebprdjui5pkoj0.apps.googleusercontent.com"
  },
  "observability": { "enabled": true }
}
