---
// Template for every guide: the answer first, then the steps (the slot), Darnly, FAQ, sources and more guides.
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DarnlyStrip from '../components/DarnlyStrip.astro';
import { GUIDES } from '../data/site';

interface Props {
  slug: string;
  title: string;
  description: string;
  h1: string;
  // The first sentence answers the page's question. Plain text.
  lede: string;
  faq: { q: string; a: string }[];
  // Pages it checked facts on, shown at the bottom with the date checked.
  sources?: { name: string; url?: string }[];
  // Pages outside /guides/ (like /what-is-darnly/) set their own path and breadcrumb.
  path?: string;
  crumb?: { name: string; href: string } | null;
  // Optional page-specific line for the Darnly strip.
  strip?: { lead: string; text: string };
}

const PUBLISHED = '2026-11-02';
const {
  slug,
  title,
  description,
  h1,
  lede,
  faq,
  sources = [],
  path = `/guides/${slug}/`,
  crumb = { name: 'Guides', href: '/guides/' },
  strip,
} = Astro.props;
const source = `guide-${slug}`;
const canonical = new URL(path, Astro.site).toString();
const site = Astro.site!.toString();
const darnly = { '@type': 'Organization', name: 'Darnly', url: 'https://darnly.dev', logo: new URL('/icon.png', Astro.site).toString() };
const others = GUIDES.filter((g) => g.slug !== slug).slice(0, 4);
// FAQ answers may hold simple links; search engines get the plain text.
const plain = (s: string) => s.replace(/<[^>]+>/g, '');

const crumbs = [{ name: 'Darnly', item: site }, ...(crumb ? [{ name: crumb.name, item: new URL(crumb.href, Astro.site).toString() }] : []), { name: h1, item: canonical }];

const jsonLd = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: h1,
    description,
    url: canonical,
    mainEntityOfPage: canonical,
    datePublished: PUBLISHED,
    dateModified: PUBLISHED,
    author: darnly,
    publisher: darnly,
    image: new URL('/og/default.jpg', Astro.site).toString(),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: plain(f.a) } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.item })),
  },
]);
---
<Base title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={jsonLd} />
  <SiteHeader source={source} />
  <main class="wrap guide-page">
    {crumb && <a class="crumb" href={crumb.href}>{crumb.name}</a>}
    <h1>{h1}</h1>
    <p class="lede">{lede}</p>
    <p class="date">Updated <time datetime={PUBLISHED}>2 November 2026</time></p>

    <article class="prose"><slot /></article>

    <DarnlyStrip source={source} lead={strip?.lead ?? 'Spot a bug on your site?'} text={strip?.text ?? 'Darnly is a free Chrome extension and Mac app that turns a bug you see on screen into a report your AI coding agent (Claude Code, Codex or Cursor) can fix. Press one key, click the broken part, say what you expected.'} />

    <section class="faq" aria-labelledby="faq-h">
      <h2 id="faq-h">Questions</h2>
      {faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p set:html={f.a} />
        </details>
      ))}
    </section>

    {sources.length > 0 && (
      <section class="sources" aria-labelledby="src-h">
        <h2 id="src-h">Sources</h2>
        <p>Checked on 2 November 2026. Products change, so check their pages before you decide.</p>
        <ul>{sources.map((s) => <li>{s.url ? <a href={s.url} rel="nofollow">{s.name}</a> : s.name}</li>)}</ul>
      </section>
    )}

    {others.length > 0 && (
      <section class="more" aria-labelledby="more-h">
        <div class="more-head">
          <h2 id="more-h">More guides</h2>
          <a href="/guides/">See all {GUIDES.length} guides</a>
        </div>
        <ul>{others.map((g) => <li><a href={`/guides/${g.slug}/`}><strong>{g.name}</strong><span>{g.blurb}</span></a></li>)}</ul>
      </section>
    )}
  </main>
  <SiteFooter />
</Base>
<style>
  .guide-page { padding-block: 40px 96px; max-width: 820px; }
  .crumb { font: 500 13px/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--sky); text-decoration: none; }
  h1 { font-size: clamp(32px, 4.6vw, 48px); line-height: 1.05; margin-top: 14px; }
  .lede { color: var(--ink); font-size: 20px; max-width: 62ch; margin: 16px 0 0; }
  .date { color: var(--ink-soft); font-size: 14px; margin: 10px 0 0; }
  h2 { font-size: 28px; line-height: 1.1; }
  .prose { margin-top: 32px; max-width: 68ch; }
  .prose :global(h2) { margin-top: 44px; }
  .prose :global(h3) { font-size: 21px; margin-top: 28px; }
  .prose :global(p), .prose :global(li) { color: var(--ink-soft); }
  .prose :global(strong) { color: var(--ink); }
  .prose :global(a) { color: var(--sky); font-weight: 500; }
  .prose :global(ol), .prose :global(ul) { padding-left: 22px; display: grid; gap: 8px; }
  .prose :global(code) { font: 0.88em var(--mono); background: var(--wash); padding: 1px 5px; border-radius: 5px; overflow-wrap: anywhere; }
  .prose :global(pre) { font: 14px/1.55 var(--mono); background: var(--wash); padding: 16px 18px; border-radius: 14px; overflow-x: auto; white-space: pre-wrap; }
  .prose :global(pre code) { background: none; padding: 0; }
  .prose :global(kbd) { font: 0.85em var(--mono); border: 1px solid var(--line); border-bottom-width: 2px; border-radius: 6px; padding: 1px 6px; background: var(--white); }
  .prose :global(.table) { overflow-x: auto; margin: 20px 0; }
  .prose :global(table) { border-collapse: collapse; width: 100%; font-size: 15px; }
  .prose :global(th), .prose :global(td) { text-align: left; vertical-align: top; padding: 10px 12px; border-bottom: 1px solid var(--line); color: var(--ink-soft); }
  .prose :global(th) { color: var(--ink); font-weight: 600; }
  .prose :global(.tip) { background: var(--wash); border-radius: 14px; padding: 16px 18px; margin: 20px 0; }
  .prose :global(.tip p) { margin: 0; }
  .faq, .sources, .more { margin-top: 64px; }
  .faq details { border-top: 1px solid var(--line); padding: 16px 0; max-width: 70ch; }
  .faq details:last-child { border-bottom: 1px solid var(--line); }
  .faq summary { cursor: pointer; font-weight: 600; }
  .faq p { margin: 10px 0 0; color: var(--ink-soft); }
  .faq :global(a) { color: var(--sky); }
  .sources p { color: var(--ink-soft); font-size: 15px; margin: 12px 0 0; }
  .sources ul { margin: 12px 0 0; padding-left: 22px; display: grid; gap: 6px; font-size: 15px; }
  .sources a { color: var(--sky); overflow-wrap: anywhere; }
  .more-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 16px; }
  .more-head a { color: var(--sky); font-weight: 600; text-decoration: none; }
  .more-head a:hover { text-decoration: underline; }
  .more ul { list-style: none; padding: 0; margin: 20px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
  .more a { display: grid; gap: 4px; padding: 18px; border-radius: 14px; background: var(--wash); text-decoration: none; height: 100%; }
  .more span { color: var(--ink-soft); font-size: 15px; }
</style>
