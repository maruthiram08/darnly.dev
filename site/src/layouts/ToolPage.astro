---
// Template for every free tool: a one-line Darnly note, the tool, then Darnly, more tools, how it works, FAQ.
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DarnlyStrip from '../components/DarnlyStrip.astro';
import DarnlyPanel from '../components/DarnlyPanel.astro';
import DarnlyNote from '../components/DarnlyNote.astro';
import { TOOLS } from '../data/site';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  slug: string;
  title: string;
  description: string;
  h1: string;
  lede: string;
  steps: string[];
  faq: { q: string; a: string }[];
  // Optional tool-specific line for the Darnly strip.
  strip?: { lead: string; text: string };
}

const { slug, title, description, h1, lede, steps, faq, strip } = Astro.props;
const source = `tool-${slug}`;
// Tools from the same category first, then the newest of the rest.
const self = TOOLS.find((t) => t.slug === slug);
const rest = TOOLS.filter((t) => t.slug !== slug);
const same = self?.category ? rest.filter((t) => t.category === self.category) : [];
const others = [...same, ...rest.filter((t) => !same.includes(t)).reverse()].slice(0, 3);
const canonical = new URL(`/tools/${slug}/`, Astro.site).toString();
// Each tool can have its own share picture at public/og/tools/<slug>.jpg; otherwise the site's default is used.
const image = existsSync(join(process.cwd(), 'public/og/tools', `${slug}.jpg`)) ? `/og/tools/${slug}.jpg` : undefined;

// Lets search engines show this page as a free web app with its questions.
const jsonLd = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: h1.split(':')[0],
    url: canonical,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@type': 'Organization', name: 'Darnly', url: 'https://darnly.dev' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://darnly.dev/' },
      { '@type': 'ListItem', position: 2, name: 'Free tools', item: 'https://darnly.dev/tools/' },
      { '@type': 'ListItem', position: 3, name: self?.name ?? h1.split(':')[0], item: canonical },
    ],
  },
]);
---
<Base title={title} description={description} image={image} imageAlt={`${h1.split(":")[0]}, a free tool from Darnly`}>
  <script slot="head" type="application/ld+json" set:html={jsonLd} />
  <SiteHeader source={source} />
  <main class="wrap tool-layout">
  <div class="tool-page">
    <a class="crumb" href="/tools/">Free tools</a>
    <h1>{h1}</h1>
    <p class="lede">{lede}</p>
    <DarnlyNote source={source} />

    <section class="tool" aria-label="Tool"><slot /></section>

    <DarnlyStrip source={source} lead={strip?.lead} text={strip?.text} at="tool-strip" />

    {others.length > 0 && (
      <section class="more" aria-labelledby="more-h">
        <div class="more-head">
          <h2 id="more-h">More free tools</h2>
          <a href="/tools/">See all {TOOLS.length} tools</a>
        </div>
        <ul>{others.map((t) => <li><a href={`/tools/${t.slug}/`}><strong>{t.name}</strong><span>{t.blurb}</span></a></li>)}</ul>
      </section>
    )}

    <section class="how" aria-labelledby="how-h">
      <h2 id="how-h">How it works</h2>
      <ol>{steps.map((s) => <li set:html={s} />)}</ol>
    </section>

    <section class="faq" aria-labelledby="faq-h">
      <h2 id="faq-h">Questions</h2>
      {faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p set:html={f.a} />
        </details>
      ))}
    </section>
  </div>
  <DarnlyPanel source={source} />
  </main>
  <SiteFooter />
</Base>
<style>
  .tool-layout { padding-block: 40px 96px; max-width: 960px; }
  .tool-page { min-width: 0; }
  /* Laptops and wider: the Darnly panel sits beside the tool (tool column up to 960px). */
  @media (min-width: 1100px) {
    .tool-layout { max-width: 1280px; display: grid; grid-template-columns: minmax(0, 960px) 240px; gap: 36px; align-items: start; justify-content: center; }
  }
  .crumb { font: 500 13px/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--sky); text-decoration: none; }
  h1 { font-size: clamp(32px, 4.6vw, 48px); line-height: 1.05; margin-top: 14px; }
  .lede { color: var(--ink-soft); font-size: 19px; max-width: 74ch; margin: 14px 0 0; }
  .tool { margin-top: 32px; }
  h2 { font-size: 28px; line-height: 1.1; }
  .more, .how, .faq { margin-top: 64px; }
  .more-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 16px; }
  .more-head a { color: var(--sky); font-weight: 600; text-decoration: none; }
  .more-head a:hover { text-decoration: underline; }
  .more ul { list-style: none; padding: 0; margin: 20px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
  .more a { display: grid; gap: 4px; padding: 18px; border-radius: 14px; background: var(--wash); text-decoration: none; height: 100%; }
  .more span { color: var(--ink-soft); font-size: 15px; }
  .how ol { margin: 20px 0 0; padding-left: 22px; display: grid; gap: 10px; color: var(--ink-soft); max-width: 65ch; }
  .faq details { border-top: 1px solid var(--line); padding: 16px 0; max-width: 70ch; }
  .faq details:last-child { border-bottom: 1px solid var(--line); }
  .faq summary { cursor: pointer; font-weight: 600; }
  .faq p { margin: 10px 0 0; color: var(--ink-soft); }
  :global(.tool-page code) { font: 0.9em var(--mono); }
  /* Phones: small text buttons (Copy, presets, toggles) get a finger-sized height. Empty ones (color handles) keep their size. */
  @media (pointer: coarse) {
    :global(.tool button:not(:empty)), :global(.tool select) { min-height: 40px; }
  }
</style>
