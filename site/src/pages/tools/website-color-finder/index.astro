---
import ToolPage from '../../../layouts/ToolPage.astro';

const steps = [
  'Paste the address of a site whose colors you like.',
  'We read the page and its stylesheets, then show its main background, text and accent colors, plus the color variables the site defines (with dark mode values when it has them).',
  'Click any color to copy it, copy the whole palette as CSS variables or a Tailwind theme, or copy a prompt that tells your AI coding agent to use the same colors.',
];

const faq = [
  { q: 'How do I find out what colors a website uses?', a: 'Paste the site’s address above. We read its stylesheets, the same files your browser downloads, and count which colors it uses for backgrounds, text, buttons and links. If the site names its colors with CSS variables, like <code>--primary</code>, you get those names too.' },
  { q: 'How is this different from the color palette from image tool?', a: 'The <a href="/tools/color-palette-from-image/">image palette tool</a> picks colors from pixels in a picture. This one reads the site’s code, so you get the exact colors the designer chose, their names, and dark mode values.' },
  { q: 'What are accent colors?', a: 'Clear, bright colors that aren’t close to black, white or gray. They’re usually the brand color used for buttons, links and highlights.' },
  { q: 'Which Tailwind version do I have?', a: 'If your project has a <code>tailwind.config.js</code> or <code>tailwind.config.ts</code> file, pick v3. If your CSS file starts with <code>@import "tailwindcss";</code> and there’s no config file, pick v4. Not sure? Copy the prompt for your AI agent instead and it will work it out.' },
  { q: 'Why are some colors missing?', a: 'Some sites add their styles with JavaScript after the page loads, and some block automated visits. Colors inside images and videos aren’t in the code either. We also read up to 12 stylesheets per page. If something looks off, try another page on the same site.' },
];
---
<ToolPage
  slug="website-color-finder"
  title="Website color finder: get any site’s color palette · Darnly"
  description="Paste any website to get its color palette: background, text and accent colors plus its CSS color variables. Copy them as CSS, a Tailwind theme or a prompt for your AI agent."
  h1="Website color finder: get any site’s color palette"
  lede="Paste a site to see its background, text and accent colors, and the color variables it defines. Copy them as CSS, as a Tailwind theme, or as a prompt that tells your AI agent to use them."
  steps={steps}
  faq={faq}
>
  <div class="wc">
    <form id="wc-form" class="ask">
      <label class="sr" for="wc-url">Website address</label>
      <input id="wc-url" type="text" inputmode="url" autocomplete="url" placeholder="stripe.com" required />
      <button id="wc-go" type="submit">Find colors</button>
    </form>
    <p class="error" id="wc-error" role="alert" hidden></p>

    <div id="wc-out" class="out" hidden>
      <div class="summary">
        <p id="wc-summary"></p>
        <button id="wc-prompt" type="button" class="primary">Copy prompt for your AI agent</button>
      </div>
      <div class="strip" id="wc-strip" aria-hidden="true"></div>
      <p class="status" id="wc-status" role="status" aria-live="polite"></p>

      <section class="group" id="wc-bg-box"><h2>Backgrounds</h2><ul class="swatches" id="wc-bg"></ul></section>
      <section class="group" id="wc-text-box"><h2>Text</h2><ul class="swatches" id="wc-text"></ul></section>
      <section class="group" id="wc-accent-box"><h2>Accents</h2><ul class="swatches" id="wc-accent"></ul></section>
      <section class="group" id="wc-vars-box">
        <h2>Color variables</h2>
        <p class="hint" id="wc-vars-hint"></p>
        <ul class="vars" id="wc-vars"></ul>
      </section>

      <div class="code">
        <div class="code-head"><span>CSS variables</span><button type="button" data-copy="wc-css">Copy</button></div>
        <pre id="wc-css"></pre>
      </div>

      <div class="code">
        <div class="code-head">
          <label>Tailwind
            <select id="wc-tw-version" aria-label="Tailwind version">
              <option value="v4">v4</option>
              <option value="v3">v3</option>
            </select>
          </label>
          <button type="button" data-copy="wc-tw">Copy</button>
        </div>
        <pre id="wc-tw"></pre>
      </div>

      <p class="note" id="wc-note" hidden></p>
    </div>
  </div>
</ToolPage>

<script>
  import '../../../scripts/website-color-finder';
</script>

<style>
  .wc { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; }
  .wc [hidden] { display: none !important; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .ask { display: flex; gap: 10px; }
  .ask input { flex: 1; min-width: 0; font: inherit; font-size: 18px; padding: 14px 18px; border: 2px solid var(--line); border-radius: 999px; background: var(--white); }
  .ask input:focus { outline: none; border-color: var(--sky); }
  .ask button { font: 600 16px/1 var(--body); padding: 0 26px; border: 0; border-radius: 999px; background: var(--sky); color: var(--white); cursor: pointer; white-space: nowrap; }
  .ask button:disabled { opacity: 0.6; cursor: wait; }
  .error { margin: 0; color: #B4234F; }

  .out { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; min-width: 0; }
  .summary { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center; justify-content: space-between; }
  .summary p { margin: 0; font-size: 18px; }
  .primary { font: 600 15px/1 var(--body); padding: 12px 18px; border: 0; border-radius: 999px; background: var(--ink); color: var(--white); cursor: pointer; }
  .strip { display: flex; height: 56px; border-radius: 12px; overflow: hidden; border: 1px solid var(--line); }
  .strip :global(span) { flex: 1 1 0; }
  .status { margin: -12px 0 0; min-height: 1.6em; font-size: 15px; color: var(--ink-soft); }

  .group { display: grid; gap: 10px; min-width: 0; }
  .group h2 { margin: 0; font: 700 20px/1.2 var(--display); }
  .hint { margin: 0; font-size: 14px; color: var(--ink-soft); }
  .swatches { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
  .swatches :global(.swatch) { width: 100%; min-height: 110px; display: grid; align-content: end; gap: 2px; text-align: left; padding: 14px; border: 1px solid rgba(11, 34, 48, 0.12); border-radius: 14px; cursor: pointer; font: inherit; }
  .swatches :global(.swatch strong) { font: 700 18px/1.2 var(--mono); }
  .swatches :global(.swatch span) { font: 400 12px/1.4 var(--mono); opacity: 0.85; overflow-wrap: anywhere; }
  .swatches :global(.swatch em) { font-style: normal; font-size: 12px; opacity: 0.75; margin-top: 4px; }
  .swatches :global(.swatch:hover), .vars :global(button:hover) { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(11, 34, 48, 0.12); }

  .vars { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 8px; }
  .vars :global(button) { width: 100%; display: flex; align-items: center; gap: 10px; padding: 8px 10px; border: 1px solid var(--line); border-radius: 12px; background: var(--white); color: var(--ink); cursor: pointer; font: inherit; text-align: left; min-width: 0; }
  .vars :global(.chip) { flex: none; display: flex; width: 36px; height: 36px; border-radius: 8px; overflow: hidden; border: 1px solid rgba(11, 34, 48, 0.12); }
  .vars :global(.chip i) { flex: 1; }
  .vars :global(.label) { display: grid; min-width: 0; }
  .vars :global(.label b) { font: 600 13px/1.3 var(--mono); overflow-wrap: anywhere; }
  .vars :global(.label small) { font: 400 12px/1.4 var(--mono); color: var(--ink-soft); }

  .code { border-radius: 16px; background: var(--ink); color: #D9EEF6; overflow: hidden; min-width: 0; }
  .code-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 16px; font: 500 13px/1.4 var(--mono); color: #8FB4C4; border-bottom: 1px solid rgba(217, 238, 246, 0.12); }
  .code-head label { display: flex; align-items: center; gap: 8px; }
  .code-head select { font: 500 13px/1 var(--mono); padding: 4px 8px; border-radius: 8px; background: rgba(252, 255, 255, 0.14); color: var(--white); border: 0; }
  .code-head select option { color: var(--ink); }
  .code-head button { font: 600 13px/1 var(--body); padding: 7px 12px; border-radius: 8px; border: 0; background: rgba(252, 255, 255, 0.14); color: var(--white); cursor: pointer; }
  .code pre { margin: 0; padding: 16px; overflow-x: auto; max-height: 420px; font: 400 13px/1.7 var(--mono); }
  .note { margin: 0; font-size: 14px; color: var(--ink-soft); }
  @media (max-width: 560px) {
    .ask { flex-direction: column; }
    .ask button { padding: 14px 26px; }
    .swatches { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
