---
import ToolPage from '../../../layouts/ToolPage.astro';

const steps = [
  'Pick what your page is about: your company, an app, a product, an article, an FAQ, a local business, an event or a breadcrumb path. An example is filled in so you can see the result straight away.',
  'Replace the example with your own details. The preview shows roughly how Google could display your page, and the box above it tells you in plain words if anything is missing.',
  'Click Copy and paste the code into the page it describes. Or pick “AI prompt” and paste it into Claude Code, Cursor or Codex, and it will add it for you.',
  'Check it with Google’s free <a href="https://search.google.com/test/rich-results" rel="noopener">Rich Results Test</a> once it’s live.',
];

const faq = [
  { q: 'What is structured data, or JSON-LD?', a: 'A small block of code that tells search engines exactly what a page is about: “this is a product, it costs $129, it has 4.6 stars”. Google reads it to show extras like stars, prices, event dates and your logo in search results. JSON-LD is the format Google recommends.' },
  { q: 'Will Google definitely show stars or other extras?', a: 'No. Correct structured data makes your page <em>eligible</em>, but Google decides when to show the extras. Make sure everything in the code is also visible on the page, and that ratings come from real reviews.' },
  { q: 'Why don’t my FAQ dropdowns show on Google?', a: 'Since August 2023 Google only shows FAQ results for well-known government and health sites. FAQ markup is still valid, and other search engines and AI assistants can read it, but most sites won’t see the dropdowns.' },
  { q: 'Can I add more than one type to a page?', a: 'Yes. For example, a product page can have both Product and Breadcrumbs. Make one block for each and paste both. Organization and WebSite usually go on your home page only.' },
  { q: 'Where does it go in Next.js or Astro?', a: 'Pick the Next.js or Astro tab above the code and it gives you the right pattern. Or pick “AI prompt” and let your coding agent put it in the right file.' },
  { q: 'Is anything I type sent anywhere?', a: 'No. Everything happens in your browser. Nothing you type leaves your computer.' },
];
---
<ToolPage
  slug="schema-generator"
  title="Schema markup generator (JSON-LD) with Google preview · Darnly"
  description="Make structured data for your company, app, product, article, FAQ, local business, event or breadcrumbs. See a Google rich result preview, fix what’s missing, copy the JSON-LD. Free and private."
  h1="Schema markup generator: get stars, prices and logos on Google"
  lede="Pick what your page is about, fill in a few boxes, and get the JSON-LD code that tells Google. See how your result could look as you type."
  steps={steps}
  faq={faq}
>
  <div class="sg">
    <div class="types" id="sg-types" role="radiogroup" aria-label="What is your page about?"></div>

    <div class="preview">
      <div class="verdict" id="sg-verdict" data-state="good" role="status">
        <span class="dot" aria-hidden="true"></span>
        <span id="sg-verdict-text">Ready for Google</span>
      </div>
      <div class="serp" aria-label="Google result preview (a mock-up)">
        <div class="serp-bar"><span class="serp-g">Google</span><span class="serp-q" aria-hidden="true"></span></div>
        <div class="stage" id="sg-stage"></div>
      </div>
      <ul class="issues" id="sg-issues" hidden></ul>
      <p class="rich" id="sg-rich"></p>
    </div>

    <div class="grid">
      <div>
        <div class="form-head">
          <h2 class="sub">Your details</h2>
          <div class="form-btns">
            <button type="button" id="sg-example">Example</button>
            <button type="button" id="sg-blank">Start blank</button>
          </div>
        </div>
        <div class="form" id="sg-form"></div>
      </div>

      <div class="out">
        <h2 class="sub">Your code</h2>
        <div class="formats" id="sg-formats" role="tablist" aria-label="Code format">
          <button type="button" role="tab" data-format="html" aria-selected="true">HTML</button>
          <button type="button" role="tab" data-format="next" aria-selected="false">Next.js</button>
          <button type="button" role="tab" data-format="astro" aria-selected="false">Astro</button>
          <button type="button" role="tab" data-format="prompt" aria-selected="false">AI prompt</button>
        </div>
        <div class="code">
          <div class="code-head"><span>JSON-LD</span><button id="sg-copy" type="button">Copy</button></div>
          <pre id="sg-code"></pre>
        </div>
        <p class="fnote" id="sg-format-note"></p>
        <details class="fold">
          <summary>Check it after it’s live</summary>
          <p>Paste your page’s link into Google’s <a href="https://search.google.com/test/rich-results" rel="noopener">Rich Results Test</a> or the <a href="https://validator.schema.org/" rel="noopener">Schema.org validator</a>. Then make sure your title and share preview are right with the <a href="/tools/meta-tag-generator/">meta tag generator</a>, and run the <a href="/tools/launch-checker/">launch checker</a> before you ship.</p>
        </details>
      </div>
    </div>
  </div>
</ToolPage>

<script>
  import '../../../scripts/schema-generator';
</script>

<style>
  [hidden] { display: none !important; }
  .sg { display: grid; gap: 28px; }
  .sub { font-size: 20px; line-height: 1.2; }

  .types { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; }
  .sg :global(.type) { display: grid; gap: 2px; text-align: left; padding: 10px 12px; border-radius: 12px; border: 1px solid var(--line); background: var(--white); color: var(--ink); font: inherit; cursor: pointer; }
  .sg :global(.type strong) { font-size: 15px; }
  .sg :global(.type span) { font-size: 13px; line-height: 1.35; color: var(--ink-soft); }
  .sg :global(.type[aria-checked='true']) { border-color: var(--sky); background: var(--wash); box-shadow: inset 0 0 0 1px var(--sky); }

  .preview { display: grid; gap: 12px; }
  .verdict { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-radius: 12px; font-weight: 600; }
  .verdict[data-state='good'] { background: #E3F5EB; color: #145A37; }
  .verdict[data-state='bad'] { background: #FFF2D6; color: #6E4B00; }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: currentColor; flex: none; }
  .serp { border: 1px solid var(--line); border-radius: 16px; background: #fff; overflow: hidden; font-family: Arial, Helvetica, sans-serif; color: #202124; }
  .serp-bar { display: flex; align-items: center; gap: 14px; padding: 12px 18px; border-bottom: 1px solid #ebebeb; }
  .serp-g { font: 700 20px/1 Arial, sans-serif; color: #4285F4; letter-spacing: -0.5px; }
  .serp-q { flex: 1; max-width: 420px; height: 30px; border-radius: 15px; border: 1px solid #dfe1e5; }
  .stage { padding: 22px 18px 26px; min-height: 160px; overflow-wrap: anywhere; }
  .issues { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .issues :global(li) { padding: 8px 12px 8px 34px; border-radius: 10px; font-size: 15px; position: relative; }
  .issues :global(li::before) { position: absolute; left: 12px; top: 8px; font-weight: 700; }
  .issues :global(li.bad) { background: #FFF2D6; color: #5C3F00; }
  .issues :global(li.bad::before) { content: '!'; }
  .issues :global(li.tip) { background: var(--wash); color: var(--ink-soft); }
  .issues :global(li.tip::before) { content: '+'; }
  .rich { margin: 0; font-size: 14px; color: var(--ink-soft); }

  /* Google result mock-ups */
  .sg :global(.g-result) { display: grid; gap: 3px; max-width: 600px; position: relative; }
  .sg :global(.g-result.with-thumb) { padding-right: 112px; min-height: 96px; }
  .sg :global(.g-head) { display: flex; align-items: center; gap: 10px; margin-bottom: 4px; }
  .sg :global(.g-fav) { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: #f1f3f4; border: 1px solid #e3e3e3; font: 700 13px/1 Arial, sans-serif; color: #4d5156; flex: none; }
  .sg :global(.g-fav.sm) { width: 18px; height: 18px; font-size: 10px; }
  .sg :global(.g-src) { display: grid; line-height: 1.3; }
  .sg :global(.g-site) { font-size: 14px; color: #202124; }
  .sg :global(.g-url) { font-size: 12px; color: #4d5156; }
  .sg :global(.g-title) { font-size: 20px; line-height: 1.3; color: #1a0dab; }
  .sg :global(.g-desc) { font-size: 14px; line-height: 1.58; color: #4d5156; }
  .sg :global(.g-meta) { font-size: 14px; color: #4d5156; }
  .sg :global(.g-link) { color: #1a0dab; }
  .sg :global(.g-rating) { display: flex; align-items: center; gap: 6px; font-size: 14px; color: #4d5156; }
  .sg :global(.g-stars) { position: relative; color: #dadce0; letter-spacing: 1px; font-size: 15px; }
  .sg :global(.g-stars::after) { content: '★★★★★'; position: absolute; inset: 0; width: var(--fill); overflow: hidden; color: #fbbc04; white-space: nowrap; }
  .sg :global(.g-thumb) { position: absolute; right: 0; top: 34px; width: 96px; height: 96px; border-radius: 10px; background: #f1f3f4; display: grid; place-items: center; font-size: 36px; overflow: hidden; }
  .sg :global(.g-thumb img), .sg :global(.story-img img), .sg :global(.event-img img), .sg :global(.kp-logo img) { width: 100%; height: 100%; object-fit: cover; }
  .sg :global(.g-faq) { margin-top: 8px; border-top: 1px solid #ebebeb; }
  .sg :global(.g-faq details) { border-bottom: 1px solid #ebebeb; }
  .sg :global(.g-faq summary) { padding: 10px 0; font-size: 15px; cursor: pointer; color: #202124; }
  .sg :global(.g-faq p) { margin: 0 0 12px; font-size: 14px; color: #4d5156; }

  .sg :global(.kp), .sg :global(.local) { max-width: 440px; border: 1px solid #dadce0; border-radius: 12px; overflow: hidden; }
  .sg :global(.kp) { padding: 18px; display: grid; gap: 12px; }
  .sg :global(.kp-top) { display: flex; align-items: center; gap: 14px; }
  .sg :global(.kp-logo) { width: 56px; height: 56px; border-radius: 12px; background: #e8f0fe; color: #1a73e8; display: grid; place-items: center; font: 700 26px/1 Arial, sans-serif; overflow: hidden; flex: none; }
  .sg :global(.kp-name) { display: block; font-size: 22px; line-height: 1.25; color: #202124; }
  .sg :global(.kp-kind) { font-size: 14px; color: #70757a; }
  .sg :global(.kp-desc) { margin: 0; font-size: 14px; line-height: 1.55; color: #4d5156; }
  .sg :global(.kp-facts) { margin: 0; display: grid; gap: 6px; font-size: 14px; }
  .sg :global(.kp-facts div) { display: flex; gap: 6px; }
  .sg :global(.kp-facts dt) { font-weight: 700; color: #202124; }
  .sg :global(.kp-facts dt::after) { content: ':'; }
  .sg :global(.kp-facts dd) { margin: 0; color: #4d5156; }
  .sg :global(.kp-facts dd.open) { color: #188038; }
  .sg :global(.kp-profiles) { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; font-size: 13px; }
  .sg :global(.kp-label) { font-weight: 700; margin-right: 4px; }
  .sg :global(.kp-chip) { padding: 4px 10px; border-radius: 14px; background: #f1f3f4; color: #202124; text-transform: capitalize; }
  .sg :global(.map) { height: 110px; display: grid; place-items: center; background: linear-gradient(135deg, #e8f0e3 0 25%, #f4f1e8 25% 50%, #e3eef4 50% 75%, #f4f1e8 75%) 0 0 / 40px 40px; }
  .sg :global(.pin) { font-size: 30px; }
  .sg :global(.local-body) { padding: 16px 18px; display: grid; gap: 6px; }
  .sg :global(.local-btns) { display: flex; gap: 8px; margin-top: 6px; }
  .sg :global(.local-btns span) { padding: 6px 12px; border-radius: 16px; border: 1px solid #dadce0; font-size: 13px; color: #1a73e8; }

  .sg :global(.story-label) { display: block; font-size: 18px; color: #202124; margin-bottom: 10px; }
  .sg :global(.story-card) { display: grid; max-width: 300px; border: 1px solid #dadce0; border-radius: 12px; overflow: hidden; }
  .sg :global(.story-img) { aspect-ratio: 16 / 9; background: #f1f3f4; display: grid; place-items: center; font-size: 40px; overflow: hidden; }
  .sg :global(.story-body) { padding: 12px 14px; display: grid; gap: 6px; }
  .sg :global(.story-pub) { display: flex; align-items: center; gap: 6px; font-size: 12px; color: #202124; }
  .sg :global(.story-title) { font-size: 16px; line-height: 1.35; color: #1a0dab; }
  .sg :global(.story-date) { font-size: 12px; color: #70757a; }
  .sg :global(.event-card) { display: flex; gap: 14px; align-items: center; max-width: 560px; padding: 14px; border: 1px solid #dadce0; border-radius: 12px; }
  .sg :global(.cal) { display: grid; text-align: center; width: 54px; flex: none; }
  .sg :global(.cal-m) { font-size: 12px; font-weight: 700; color: #d93025; }
  .sg :global(.cal-d) { font-size: 26px; color: #202124; }
  .sg :global(.event-body) { display: grid; gap: 4px; flex: 1; min-width: 0; }
  .sg :global(.event-price) { font-size: 13px; color: #188038; }
  .sg :global(.event-img) { width: 84px; height: 84px; border-radius: 10px; background: #f1f3f4; display: grid; place-items: center; font-size: 30px; overflow: hidden; flex: none; }

  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 32px; align-items: start; }
  .form-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 14px; flex-wrap: wrap; }
  .form-btns { display: flex; gap: 8px; }
  .form-btns button, .sg :global(.pair-add) { font: 600 14px/1 var(--body); padding: 8px 12px; border-radius: 8px; border: 1px solid var(--line); background: var(--white); color: var(--ink); cursor: pointer; }
  .form { display: grid; gap: 14px; }
  .sg :global(.field) { display: grid; gap: 6px; }
  .sg :global(.lab) { display: flex; gap: 8px; align-items: baseline; font-weight: 600; font-size: 15px; }
  .sg :global(.req) { font: 500 11px/1 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--pink); }
  .sg :global(.hint) { font-size: 13px; color: var(--ink-soft); }
  .sg :global(.field input), .sg :global(.field textarea), .sg :global(.field select), .sg :global(.pair input), .sg :global(.pair textarea) { width: 100%; font: inherit; font-size: 16px; padding: 9px 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--white); color: var(--ink); resize: vertical; }
  .sg :global(.field :focus), .sg :global(.pair :focus) { outline: 3px solid var(--pink); outline-offset: 1px; }
  .sg :global(.pairs) { display: grid; gap: 10px; }
  .sg :global(.pair) { display: grid; grid-template-columns: 24px minmax(0, 1fr) 32px; gap: 8px; align-items: start; }
  .sg :global(.pair-n) { font: 600 13px/38px var(--mono); color: var(--ink-soft); text-align: center; }
  .sg :global(.pair-fields) { display: grid; gap: 6px; }
  .sg :global(.pair-del) { width: 32px; height: 38px; border: 0; border-radius: 8px; background: var(--wash); color: var(--ink-soft); font-size: 18px; cursor: pointer; }
  .sg :global(.pair-del:disabled) { opacity: 0.35; cursor: default; }
  .sg :global(.pair-add) { justify-self: start; }

  .out { display: grid; gap: 12px; }
  .formats { display: flex; flex-wrap: wrap; gap: 6px; }
  .formats button { font: 600 14px/1 var(--body); padding: 8px 12px; border-radius: 8px; border: 1px solid var(--line); background: var(--white); color: var(--ink); cursor: pointer; }
  .formats button[aria-selected='true'] { background: var(--ink); border-color: var(--ink); color: var(--white); }
  .code { border-radius: 16px; background: var(--ink); color: #D9EEF6; overflow: hidden; }
  .code-head { display: flex; justify-content: space-between; align-items: center; padding: 10px 16px; font: 500 13px/1.4 var(--mono); color: #8FB4C4; border-bottom: 1px solid rgba(217, 238, 246, 0.12); }
  .code-head button { font: 600 13px/1 var(--body); padding: 7px 12px; border-radius: 8px; border: 0; background: rgba(252, 255, 255, 0.14); color: var(--white); cursor: pointer; }
  .code pre { margin: 0; padding: 16px; overflow: auto; max-height: 460px; font: 400 13px/1.65 var(--mono); font-variant-ligatures: none; white-space: pre-wrap; overflow-wrap: anywhere; }
  .fnote { margin: 0; font-size: 14px; color: var(--ink-soft); }
  .fold { border-top: 1px solid var(--line); padding-top: 10px; font-size: 15px; }
  .fold summary { cursor: pointer; font-weight: 600; }
  .fold p { margin: 8px 0 0; color: var(--ink-soft); }

  @media (max-width: 760px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
    .stage { padding: 18px 14px 22px; }
    .sg :global(.g-result.with-thumb) { padding-right: 84px; }
    .sg :global(.g-thumb) { width: 72px; height: 72px; }
    .sg :global(.event-img) { display: none; }
    .types { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
    .sg :global(.type) { padding: 8px; text-align: center; }
    .sg :global(.type strong) { font-size: 13px; }
    .sg :global(.type span) { display: none; }
  }
</style>
