---
import ToolPage from '../../../layouts/ToolPage.astro';

const steps = [
  'Drop in a screenshot, logo or photo. You can also paste one straight from your clipboard.',
  'We pick out its main colors, biggest first. Choose how many you want, from 5 to 8.',
  'Click a color to copy its hex code, or copy the CSS variables or Tailwind snippet and paste it into your project. You can also hand the snippet to your AI coding agent and say “use these colors”.',
];

const faq = [
  { q: 'Is my image uploaded anywhere?', a: 'No. Everything happens in your browser. Your image never leaves your computer.' },
  { q: 'How are the colors picked?', a: 'We look at every pixel, group the ones that look alike, and show the biggest groups. Small accent colors still get a slot when they’re clearly different, so a logo’s one bright detail isn’t lost. See-through areas are ignored.' },
  { q: 'Which Tailwind version do I have?', a: 'If your project has a <code>tailwind.config.js</code> or <code>tailwind.config.ts</code> file, pick v3. If your CSS file starts with <code>@import "tailwindcss";</code> and there’s no config file, pick v4. Not sure? Ask your AI coding agent.' },
  { q: 'How do I give these colors to my AI coding agent?', a: 'Copy the CSS variables or the Tailwind snippet and paste it into Claude Code, Codex or Cursor with a line like “Use these as the site’s brand colors.” The names (<code>--color-1</code> and so on) are easy to rename later.' },
  { q: 'Why do I get fewer colors than I asked for?', a: 'Some images only have a few clearly different colors, like a two-color logo. We don’t invent near-duplicates just to fill the row.' },
];
---
<ToolPage
  slug="color-palette-from-image"
  title="Color palette from image: get the main colors in one click · Darnly"
  description="Drop a screenshot or logo and get its main colors as hex codes, CSS variables and a Tailwind snippet. Free, instant, and your image never leaves your browser."
  h1="Color palette from image: the main colors in one click"
  lede="Drop a screenshot, logo or photo and get its 5 to 8 main colors. Click any color to copy it, or grab the CSS variables and Tailwind snippet. It runs in your browser, so nothing is uploaded."
  steps={steps}
  faq={faq}
>
  <div class="cp">
    <label class="drop" id="cp-drop">
      <input id="cp-file" type="file" accept="image/*" />
      <strong>Drop your image here</strong>
      <span id="cp-drop-text">or click to choose a file. You can also paste an image.</span>
    </label>
    <p class="error" id="cp-error" role="alert" hidden></p>

    <div class="result" id="cp-result" hidden>
      <div class="top">
        <img id="cp-preview" alt="Your image" />
        <div class="side">
          <div class="controls">
            <label>Colors
              <select id="cp-count">
                <option value="5">5</option>
                <option value="6" selected>6</option>
                <option value="7">7</option>
                <option value="8">8</option>
              </select>
            </label>
            <button id="cp-copy-all" type="button" class="ghost">Copy all hex codes</button>
          </div>
          <div class="strip" id="cp-strip" aria-hidden="true"></div>
          <p class="status" id="cp-status" role="status" aria-live="polite"></p>
        </div>
      </div>

      <ul class="swatches" id="cp-swatches"></ul>

      <div class="code">
        <div class="code-head"><span>CSS variables</span><button type="button" data-copy="cp-css">Copy</button></div>
        <pre id="cp-css"></pre>
      </div>

      <div class="code">
        <div class="code-head">
          <label>Tailwind
            <select id="cp-tw-version" aria-label="Tailwind version">
              <option value="v4">v4</option>
              <option value="v3">v3</option>
            </select>
          </label>
          <button type="button" data-copy="cp-tw">Copy</button>
        </div>
        <pre id="cp-tw"></pre>
      </div>
    </div>
  </div>
</ToolPage>

<script>
  import '../../../scripts/color-palette-from-image';
</script>

<style>
  .cp { display: grid; gap: 20px; min-width: 0; }
  .drop { position: relative; display: grid; place-items: center; gap: 6px; text-align: center; padding: 48px 24px; border: 2px dashed var(--line); border-radius: 20px; background: var(--wash); cursor: pointer; }
  .drop:hover, .drop:global(.over) { border-color: var(--sky); }
  .drop input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .drop strong { font: 700 22px/1.2 var(--display); }
  .drop span { color: var(--ink-soft); }
  .drop:focus-within { outline: 3px solid var(--pink); outline-offset: 3px; }
  .error { margin: 0; color: #B4234F; }
  .result { display: grid; gap: 24px; min-width: 0; }
  .top { display: grid; grid-template-columns: minmax(0, 220px) minmax(0, 1fr); gap: 24px; align-items: start; }
  .top img { width: 100%; max-height: 220px; object-fit: contain; border-radius: 12px; background: repeating-conic-gradient(#e6eef2 0 25%, #fff 0 50%) 0 0 / 12px 12px; }
  .side { display: grid; gap: 16px; min-width: 0; }
  .controls { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
  .controls label { display: flex; align-items: center; gap: 8px; font-size: 15px; }
  select { font: inherit; font-size: 15px; padding: 6px 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--white); color: var(--ink); }
  .ghost { font: 600 15px/1 var(--body); padding: 10px 16px; border: 1px solid var(--line); border-radius: 999px; background: var(--white); color: var(--ink); cursor: pointer; }
  .ghost:hover { border-color: var(--sky); }
  .strip { display: flex; height: 56px; border-radius: 12px; overflow: hidden; border: 1px solid var(--line); }
  .strip :global(span) { flex-basis: 0; }
  .status { margin: 0; min-height: 1.6em; font-size: 15px; color: var(--ink-soft); }
  .swatches { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
  .swatches :global(.swatch) { width: 100%; min-height: 120px; display: grid; align-content: end; gap: 2px; text-align: left; padding: 14px; border: 1px solid rgba(11, 34, 48, 0.12); border-radius: 14px; cursor: pointer; font: inherit; }
  .swatches :global(.swatch strong) { font: 700 18px/1.2 var(--mono); }
  .swatches :global(.swatch span) { font: 400 12px/1.4 var(--mono); opacity: 0.85; }
  .swatches :global(.swatch em) { font-style: normal; font-size: 12px; opacity: 0.75; margin-top: 4px; }
  .swatches :global(.swatch:hover) { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(11, 34, 48, 0.12); }
  .code { border-radius: 16px; background: var(--ink); color: #D9EEF6; overflow: hidden; min-width: 0; }
  .code-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 16px; font: 500 13px/1.4 var(--mono); color: #8FB4C4; border-bottom: 1px solid rgba(217, 238, 246, 0.12); }
  .code-head label { display: flex; align-items: center; gap: 8px; }
  .code-head select { font: 500 13px/1 var(--mono); padding: 4px 8px; background: rgba(252, 255, 255, 0.14); color: var(--white); border: 0; }
  .code-head select option { color: var(--ink); }
  .code-head button { font: 600 13px/1 var(--body); padding: 7px 12px; border-radius: 8px; border: 0; background: rgba(252, 255, 255, 0.14); color: var(--white); cursor: pointer; }
  .code pre { margin: 0; padding: 16px; overflow-x: auto; font: 400 13px/1.7 var(--mono); }
  @media (max-width: 560px) {
    .top { grid-template-columns: minmax(0, 1fr); }
    .top img { max-height: 180px; }
    .swatches { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
