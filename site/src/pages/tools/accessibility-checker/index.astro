---
import ToolPage from '../../../layouts/ToolPage.astro';

const steps = [
  'Paste the address of your site.',
  'We read the page’s HTML and run 11 checks a machine can do reliably: page language, pinch to zoom, alt text, names for links and buttons, form labels, heading order, main and nav regions, tabindex, autoplaying media and text contrast set in inline styles.',
  'You get a score, a card for each problem with the exact HTML that causes it and a one-line fix, and one prompt that asks your AI agent to fix them all.',
];

const faq = [
  { q: 'Does a score of 100 mean my site is accessible?', a: 'No. Automated checks catch only about a third of accessibility problems. They can tell that an image has no alt text, but not whether the alt text makes sense, and they can’t try your site with a keyboard or a screen reader. A high score means the basics are in place. Try using your site with only the Tab and Enter keys to find more.' },
  { q: 'Why does it say my page is built by JavaScript?', a: 'Sites made with Vite, React or Lovable often send an almost empty page and build everything in the browser. We read the HTML the server sends, so we can only check the language, zoom and keyboard settings. For the rest, open your site in Chrome, press F12, open Lighthouse and run an Accessibility report.' },
  { q: 'What is alt text and what should I write?', a: 'Alt text is a short description of an image that screen readers read out and search engines index. Say what the image shows in context, like “Darnly turning a bug into a prompt”. For an image that is only decoration, use alt="" so screen readers skip it.' },
  { q: 'What does “no name” mean for a link or button?', a: 'A screen reader reads a link or button by its text. Icon buttons (a menu, a close X, a search glass) and social icons often have no text, so the screen reader just says “button” or “link”. Add aria-label="Open menu" (or similar) to fix it without changing the look.' },
  { q: 'Why does blocking zoom matter?', a: 'People with low vision pinch to zoom on phones. A viewport tag with user-scalable=no or maximum-scale=1 stops them. Many starter templates add it to stop iPhones zooming into form fields; a 16px font size on inputs fixes that instead.' },
  { q: 'Do you keep the pages I check?', a: 'No. We read the page once to run the checks and send the results back. Nothing is saved, cached or logged.' },
];
---
<ToolPage
  slug="accessibility-checker"
  title="Accessibility checker: is my website accessible? · Darnly"
  description="Free website accessibility checker. Paste a URL to check alt text, button and link names, form labels, headings, zoom, contrast and more, with the exact HTML to fix and one prompt for your AI agent."
  h1="Accessibility checker: is my site accessible?"
  lede="Paste your site and get an accessibility score in seconds, with the exact HTML behind each problem, a one-line fix, and one prompt that asks Claude Code, Cursor or Codex to fix them all."
  steps={steps}
  faq={faq}
>
  <div class="ax">
    <form id="ax-form" class="ask">
      <label class="sr" for="ax-url">Website address</label>
      <input id="ax-url" type="text" inputmode="url" autocomplete="url" placeholder="yoursite.com" required />
      <button id="ax-go" type="submit">Check accessibility</button>
    </form>
    <p class="error" id="ax-error" role="alert" hidden></p>

    <div id="ax-out" hidden>
      <section class="hero" id="ax-hero" aria-live="polite">
        <div class="ring" id="ax-ring">
          <svg viewBox="0 0 120 120" aria-hidden="true">
            <circle class="track" cx="60" cy="60" r="52" />
            <circle class="bar" id="ax-bar" cx="60" cy="60" r="52" />
          </svg>
          <div class="num"><strong id="ax-score">0</strong><span id="ax-of">/ 100</span></div>
        </div>
        <div class="verdict-box">
          <p class="site" id="ax-site"></p>
          <p class="verdict" id="ax-verdict"></p>
          <p class="counts" id="ax-counts"></p>
          <button class="copy-all" id="ax-copy" type="button">Copy one prompt to fix all of these</button>
        </div>
        <ul class="tiles" id="ax-tiles" aria-label="All checks"></ul>
      </section>

      <p class="third">
        <b>Automated checks catch about a third of accessibility problems.</b> A good score means the basics are in place, not that the site works for everyone. Also try your site with only the Tab and Enter keys, check colors from your stylesheets with the <a href="/tools/contrast-checker/">contrast checker</a>, and see your design through color-blind eyes with the <a href="/tools/color-blindness-simulator/">color blindness simulator</a>.
      </p>

      <ul class="cards" id="ax-cards"></ul>

      <details class="passed" id="ax-passed-box">
        <summary id="ax-passed-sum"></summary>
        <ul id="ax-passed"></ul>
      </details>
      <p class="note" id="ax-note" hidden></p>
    </div>
  </div>
</ToolPage>

<script>
  import '../../../scripts/accessibility-checker';
</script>

<style>
  .ax [hidden] { display: none !important; }
  .ax { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .ask { display: flex; gap: 10px; }
  .ask input { flex: 1; min-width: 0; font: inherit; font-size: 18px; padding: 14px 18px; border: 2px solid var(--line); border-radius: 999px; background: var(--white); }
  .ask input:focus { outline: none; border-color: var(--sky); }
  .ask button { font: 600 16px/1 var(--body); padding: 0 26px; border: 0; border-radius: 999px; background: var(--sky); color: var(--white); cursor: pointer; white-space: nowrap; }
  .ask button:disabled { opacity: 0.6; cursor: wait; }
  .error { margin: 0; color: #B4234F; }

  /* Score hero */
  .hero { --tone: #1F9D55; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 18px 26px; align-items: center; padding: 24px; border: 1px solid var(--line); border-radius: 20px; background: var(--white); }
  .hero.mid { --tone: #C98A00; }
  .hero.low { --tone: #D2344F; }
  .hero.unknown { --tone: #7A8A94; }
  .ring { position: relative; width: 156px; height: 156px; }
  .ring svg { width: 100%; height: 100%; transform: rotate(-90deg); }
  .ring circle { fill: none; stroke-width: 11; }
  .ring .track { stroke: var(--wash); }
  .ring .bar { stroke: var(--tone); stroke-linecap: round; stroke-dasharray: 326.73; stroke-dashoffset: 326.73; transition: stroke-dashoffset 0.9s ease; }
  .num { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; line-height: 1; }
  .num strong { font: 800 52px/1 var(--display); color: var(--tone); }
  .num span { font-size: 14px; color: var(--ink-soft); margin-top: 4px; }
  .site { margin: 0; font-size: 14px; color: var(--ink-soft); overflow-wrap: anywhere; }
  .verdict { margin: 4px 0 0; font: 700 26px/1.2 var(--display); }
  .counts { margin: 8px 0 0; color: var(--ink-soft); font-size: 15px; }
  .copy-all { margin-top: 14px; font: 600 15px/1 var(--body); padding: 12px 18px; border-radius: 999px; border: 0; background: var(--ink); color: var(--white); cursor: pointer; }
  .copy-all:hover { background: var(--sky); }
  .tiles { grid-column: 1 / -1; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 8px; text-align: left; justify-self: stretch; }
  .tiles :global(a) { display: flex; align-items: center; gap: 8px; padding: 9px 12px; border-radius: 10px; border: 1px solid var(--line); font-size: 14px; line-height: 1.25; color: var(--ink); text-decoration: none; background: var(--white); }
  .tiles :global(a:hover) { border-color: var(--sky); }
  .tiles :global(.dot) { flex: none; width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center; font: 700 12px/1 var(--body); color: var(--white); }
  .tiles :global(.pass .dot) { background: #1F9D55; }
  .tiles :global(.fail .dot) { background: #D2344F; }
  .tiles :global(.warn .dot) { background: #C98A00; }
  .tiles :global(.na .dot) { background: #B7C2C9; }
  .tiles :global(.na) { color: var(--ink-soft); }

  .third { margin: 0; padding: 14px 18px; border-radius: 14px; background: var(--wash); font-size: 15px; line-height: 1.5; }
  .third b { font-weight: 600; }

  /* Issue cards */
  .cards { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .cards :global(.card) { border: 1px solid var(--line); border-left-width: 6px; border-radius: 16px; padding: 18px 20px; background: var(--white); display: grid; gap: 10px; min-width: 0; scroll-margin-top: 20px; }
  .cards :global(.card.fail) { border-left-color: #D2344F; }
  .cards :global(.card.warn) { border-left-color: #C98A00; }
  .cards :global(.card:target) { box-shadow: 0 0 0 3px var(--sky); }
  .cards :global(.head) { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 12px; }
  .cards :global(.tag) { font: 700 12px/1 var(--body); text-transform: uppercase; letter-spacing: 0.04em; padding: 5px 8px; border-radius: 6px; color: var(--white); background: #D2344F; }
  .cards :global(.warn .tag) { background: #B98300; }
  .cards :global(.title) { margin: 0; font: 700 19px/1.3 var(--body); }
  .cards :global(.what) { margin: 0; font-size: 16px; font-weight: 600; }
  .cards :global(.who) { margin: 0; color: var(--ink-soft); font-size: 15px; }
  .cards :global(.fix) { margin: 0; font-size: 15px; padding: 10px 14px; border-radius: 10px; background: #EAF7EF; color: #14532D; }
  .cards :global(.fix b) { font-weight: 700; }
  .cards :global(.samples) { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .cards :global(.sample) { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 10px; align-items: start; }
  .cards :global(.sample.plain) { grid-template-columns: minmax(0, 1fr); }
  .cards :global(.thumb) { width: 64px; height: 64px; border-radius: 8px; border: 1px solid var(--line); object-fit: cover; background: var(--wash) repeating-conic-gradient(#e6ecef 0 25%, #fff 0 50%) 0 0 / 12px 12px; }
  .cards :global(.swatch) { min-width: 120px; max-width: 200px; padding: 12px; border-radius: 8px; border: 1px solid var(--line); font-size: 15px; line-height: 1.3; overflow-wrap: anywhere; }
  .cards :global(.swatch small) { display: block; margin-top: 6px; font: 700 12px/1 var(--mono); opacity: 0.9; }
  .cards :global(code.html) { display: block; font: 13px/1.5 var(--mono); background: #0F1E26; color: #E3EEF3; border-radius: 8px; padding: 10px 12px; overflow-x: auto; white-space: pre-wrap; overflow-wrap: anywhere; }
  .cards :global(.sample-note) { margin: 4px 0 0; font-size: 13px; color: var(--ink-soft); }
  .cards :global(.more) { margin: 0; font-size: 14px; color: var(--ink-soft); }
  .cards :global(.tool) { font-size: 14px; }

  .passed { border: 1px solid var(--line); border-radius: 14px; padding: 12px 18px; background: var(--white); }
  .passed summary { cursor: pointer; font-weight: 600; }
  .passed ul { margin: 10px 0 0; padding: 0; list-style: none; display: grid; gap: 8px; font-size: 14px; }
  .passed :global(li) { color: var(--ink-soft); }
  .passed :global(li b) { color: var(--ink); font-weight: 600; }
  .note { margin: 0; font-size: 14px; color: var(--ink-soft); }

  @media (max-width: 620px) {
    .ask { flex-direction: column; }
    .ask button { padding: 14px 26px; }
    .hero { grid-template-columns: minmax(0, 1fr); justify-items: center; text-align: center; padding: 20px 16px; }
    .verdict { font-size: 22px; }
    .cards :global(.sample) { grid-template-columns: minmax(0, 1fr); }
  }
</style>
