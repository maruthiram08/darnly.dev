---
import ToolPage from '../../../layouts/ToolPage.astro';

const steps = [
  'Drop in one image or a whole batch: WebP, AVIF, PNG, JPG or SVG. You can also paste a screenshot.',
  'Pick what you want back: PNG, JPG or WebP. Set a width if you want it smaller, and the quality for JPG or WebP.',
  'Download each file, or all of them at once as a ZIP. Change a setting and every image is converted again.',
];

const faq = [
  { q: 'Are my images uploaded anywhere?', a: 'No. The converting happens in your browser. Your images never leave your computer.' },
  { q: 'How do I turn a WebP into a PNG or JPG?', a: 'Drop the WebP file in, pick PNG (keeps transparency) or JPG (smaller, no transparency), and click Download.' },
  { q: 'How do I turn an SVG into a PNG?', a: 'Drop the SVG in and pick PNG. Type a width, like 1024 or 2048, to get a sharp PNG at any size, since SVGs scale without getting blurry.' },
  { q: 'Which format should I use on my website?', a: 'WebP for photos and screenshots: it is usually much smaller than PNG or JPG at the same look, and every current browser shows it. PNG for logos and anything with sharp edges or transparency. JPG when a tool or form only takes JPG.' },
  { q: 'What happens to transparent areas when I pick JPG?', a: 'JPG can’t be see-through, so transparent areas are filled with the background color you pick (white unless you change it).' },
  { q: 'Can it open HEIC photos from an iPhone?', a: 'Only in browsers that can open HEIC themselves, like Safari. In Chrome, ask your iPhone to share the photo as a JPG first, or change Settings, Camera, Formats to Most Compatible.' },
];
---
<ToolPage
  slug="image-converter"
  title="Free image converter: WebP, AVIF, SVG to PNG, JPG or WebP · Darnly"
  description="Convert WebP to PNG, SVG to PNG, AVIF to JPG and more, with an optional resize. Free, works on a whole batch, and your images never leave your browser."
  h1="Image converter: WebP, AVIF, SVG to PNG, JPG or WebP"
  lede="Drop in images and get them back as PNG, JPG or WebP, at the size you want. It runs in your browser, so nothing is uploaded."
  steps={steps}
  faq={faq}
>
  <div class="ic">
    <label class="drop" id="ic-drop">
      <input id="ic-file" type="file" accept="image/*,.avif,.webp,.svg" multiple />
      <strong>Drop your images here</strong>
      <span id="ic-drop-text">or click to choose files. You can also paste an image.</span>
    </label>
    <p class="error" id="ic-error" role="alert" hidden></p>

    <fieldset class="formats">
      <legend>Convert to</legend>
      <label><input type="radio" name="ic-format" value="image/png" checked /> PNG</label>
      <label><input type="radio" name="ic-format" value="image/jpeg" /> JPG</label>
      <label><input type="radio" name="ic-format" value="image/webp" /> WebP</label>
    </fieldset>

    <div class="controls">
      <label>Width <input id="ic-width" type="number" min="1" max="8192" step="1" placeholder="Same as now" inputmode="numeric" /> px</label>
      <label id="ic-quality-wrap" hidden>Quality <input id="ic-quality" type="range" min="40" max="100" value="85" /> <output id="ic-quality-out">85</output></label>
      <label id="ic-bg-wrap" hidden>Fill see-through areas <input id="ic-bg" type="color" value="#ffffff" aria-label="Fill color for see-through areas" /></label>
    </div>

    <div class="result" id="ic-result" hidden>
      <ul class="list" id="ic-list" aria-live="polite"></ul>
      <p class="note" id="ic-note" hidden></p>
      <div class="actions">
        <button id="ic-zip" type="button" class="primary" hidden>Download all (ZIP)</button>
        <button id="ic-clear" type="button" class="ghost">Start over</button>
      </div>
    </div>
  </div>
</ToolPage>

<script>
  import '../../../scripts/image-converter';
</script>

<style>
  .ic { display: grid; gap: 20px; min-width: 0; }
  .drop { position: relative; display: grid; place-items: center; gap: 6px; text-align: center; padding: 48px 24px; border: 2px dashed var(--line); border-radius: 20px; background: var(--wash); cursor: pointer; }
  .drop:hover, .drop:global(.over) { border-color: var(--sky); }
  .drop input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .drop strong { font: 700 22px/1.2 var(--display); }
  .drop span { color: var(--ink-soft); }
  .drop:focus-within { outline: 3px solid var(--pink); outline-offset: 3px; }
  .error { margin: 0; color: #B4234F; }
  .formats { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 0; padding: 0; border: 0; }
  .formats legend { float: left; margin-right: 6px; font-weight: 600; }
  .formats label { display: inline-flex; align-items: center; gap: 6px; padding: 9px 16px; border: 1px solid var(--line); border-radius: 999px; background: var(--white); cursor: pointer; font-weight: 600; }
  .formats label:has(input:checked) { border-color: var(--sky); background: var(--sky); color: var(--white); }
  .formats input { position: absolute; opacity: 0; pointer-events: none; }
  .formats label:has(input:focus-visible) { outline: 3px solid var(--pink); outline-offset: 2px; }
  .controls { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; }
  .controls label { display: flex; align-items: center; gap: 8px; font-size: 15px; }
  .ic [hidden] { display: none !important; }
  .controls input[type='number'] { width: 130px; font: inherit; font-size: 15px; padding: 6px 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--white); }
  .controls input[type='color'] { width: 40px; height: 32px; border: 1px solid var(--line); border-radius: 8px; padding: 2px; background: var(--white); }
  .controls output { font: 500 14px/1 var(--mono); min-width: 2.5ch; }
  .result { display: grid; gap: 16px; min-width: 0; }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .list :global(li) { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 4px 16px; padding: 12px 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--white); }
  .list :global(.name) { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  .list :global(.info) { grid-column: 1; font: 400 13px/1.4 var(--mono); color: var(--ink-soft); overflow-wrap: anywhere; }
  .list :global(.dl) { grid-column: 2; grid-row: 1 / span 2; font: 600 14px/1 var(--body); padding: 10px 14px; border-radius: 999px; background: var(--wash); color: var(--ink); text-decoration: none; white-space: nowrap; }
  .list :global(.dl:hover) { background: var(--sky); color: var(--white); }
  .note { margin: 0; color: var(--ink-soft); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .actions button.primary { font: 600 16px/1 var(--body); padding: 15px 22px; border: 0; border-radius: 999px; background: var(--sky); color: var(--white); cursor: pointer; }
  .actions button.primary:hover { background: #047FAB; }
  .actions button.ghost { font: 600 16px/1 var(--body); padding: 15px 22px; border: 1px solid var(--line); border-radius: 999px; background: transparent; color: var(--ink); cursor: pointer; }
  .actions button:disabled { opacity: 0.6; cursor: wait; }
</style>
