---
import ToolPage from '../../../layouts/ToolPage.astro';

const steps = [
  'Drop in your logo or app icon, ideally 1024×1024 pixels or larger, or an SVG.',
  'Pick a background color and padding. The previews show how it looks on an iPhone and on Android launchers that crop icons to a circle or a squircle.',
  'Download the ZIP. It has the iOS AppIcon set, the Android mipmap folders and the Expo files. Copy the prompt for your AI agent and it will put them in the right place.',
];

const faq = [
  { q: 'Is my image uploaded anywhere?', a: 'No. Everything happens in your browser. Your image never leaves your computer.' },
  { q: 'What’s in the ZIP?', a: 'An iOS <code>AppIcon.appiconset</code> with every iPhone and iPad size, the 1024 px App Store icon and <code>Contents.json</code>. Android <code>mipmap</code> folders with the launcher icon, the round icon, the adaptive foreground and background layers and their XML, plus a 512 px Google Play icon. Expo’s <code>icon.png</code> and <code>adaptive-icon.png</code> with the <code>app.json</code> lines to paste.' },
  { q: 'Does this work with Expo, Capacitor, Flutter and React Native?', a: 'Yes. Expo uses the files in <code>expo/</code>. Capacitor, Flutter and bare React Native use the <code>ios/</code> and <code>android/</code> folders. The README in the ZIP says where each one goes.' },
  { q: 'Why is my iOS icon square with no transparency?', a: 'Apple adds the rounded corners itself and rejects App Store icons with transparent pixels, so iOS icons are filled with your background color.' },
  { q: 'Why does my logo look smaller on Android?', a: 'Android launchers crop adaptive icons to different shapes and can cut off the outer third. The tool keeps your logo inside the safe area so nothing gets clipped.' },
  { q: 'My app still shows the old icon. Why?', a: 'App icons only change after a new build. In Expo, run a new development or EAS build. Phones also cache icons, so delete the app and install it again if it doesn’t update.' },
];
---
<ToolPage
  slug="app-icon-generator"
  title="Free app icon generator for iOS, Android and Expo · Darnly"
  description="Turn one image into every iOS and Android app icon size, plus Expo icon.png and adaptive-icon.png. Free, instant, and your image never leaves your browser."
  h1="App icon generator for iOS and Android"
  lede="Drop in one image and get the iOS AppIcon set, Android adaptive icons and the Expo files in one ZIP. It runs in your browser, so nothing is uploaded."
  steps={steps}
  faq={faq}
>
  <div class="ai">
    <label class="drop" id="ai-drop">
      <input id="ai-file" type="file" accept="image/*" />
      <strong>Drop your app icon here</strong>
      <span id="ai-drop-text">or click to choose a file. You can also paste an image.</span>
    </label>
    <p class="error" id="ai-error" role="alert" hidden></p>

    <div class="result" id="ai-result" hidden>
      <p class="warn" id="ai-warn" hidden></p>
      <div class="controls">
        <label>Background <input id="ai-bg" type="color" value="#ffffff" /></label>
        <label>Padding <input id="ai-pad" type="range" min="0" max="25" value="0" /></label>
      </div>

      <div class="previews" id="ai-previews" aria-label="Icon previews"></div>

      <div class="actions">
        <button id="ai-download" type="button" class="primary">Download all (ZIP)</button>
        <button id="ai-prompt" type="button" class="secondary">Copy prompt for your AI agent</button>
      </div>

      <div class="code">
        <div class="code-head"><span>Expo app.json</span><button id="ai-copy" type="button">Copy</button></div>
        <pre id="ai-appjson"></pre>
      </div>
    </div>
  </div>
</ToolPage>

<script>
  import '../../../scripts/app-icon';
</script>

<style>
  .ai { display: grid; gap: 20px; }
  .ai [hidden] { display: none !important; }
  .drop { position: relative; display: grid; place-items: center; gap: 6px; text-align: center; padding: 48px 24px; border: 2px dashed var(--line); border-radius: 20px; background: var(--wash); cursor: pointer; }
  .drop:hover, .drop:global(.over) { border-color: var(--sky); }
  .drop input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .drop strong { font: 700 22px/1.2 var(--display); }
  .drop span { color: var(--ink-soft); }
  .drop:focus-within { outline: 3px solid var(--pink); outline-offset: 3px; }
  .error { margin: 0; color: #B4234F; }
  .warn { margin: 0; padding: 12px 16px; border-radius: 12px; background: #FFF4DB; color: #6B4A00; font-size: 15px; }
  .result { display: grid; gap: 24px; }
  .controls { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; }
  .controls label { display: flex; align-items: center; gap: 8px; font-size: 15px; }
  .controls input[type='color'] { width: 40px; height: 32px; border: 1px solid var(--line); border-radius: 8px; padding: 2px; background: var(--white); }
  .previews { display: flex; flex-wrap: wrap; gap: 24px; padding: 24px; border-radius: 20px; background: linear-gradient(135deg, #2B5876, #4E4376); }
  .previews :global(figure) { margin: 0; display: grid; justify-items: center; gap: 8px; }
  .previews :global(canvas) { filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.25)); }
  .previews :global(figcaption) { font: 500 12px/1 var(--mono); color: #fff; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .actions button { font: 600 16px/1 var(--body); padding: 15px 22px; border-radius: 999px; cursor: pointer; }
  .actions button.primary { border: 0; background: var(--sky); color: var(--white); }
  .actions button.primary:hover { background: #047FAB; }
  .actions button.secondary { border: 1px solid var(--line); background: var(--white); color: var(--ink); }
  .actions button.secondary:hover { border-color: var(--sky); }
  .actions button:disabled { opacity: 0.6; cursor: wait; }
  .code { border-radius: 16px; background: var(--ink); color: #D9EEF6; overflow: hidden; }
  .code-head { display: flex; justify-content: space-between; align-items: center; padding: 10px 16px; font: 500 13px/1.4 var(--mono); color: #8FB4C4; border-bottom: 1px solid rgba(217, 238, 246, 0.12); }
  .code-head button { font: 600 13px/1 var(--body); padding: 7px 12px; border-radius: 8px; border: 0; background: rgba(252, 255, 255, 0.14); color: var(--white); cursor: pointer; }
  .code pre { margin: 0; padding: 16px; overflow-x: auto; font: 400 13px/1.7 var(--mono); }
</style>
