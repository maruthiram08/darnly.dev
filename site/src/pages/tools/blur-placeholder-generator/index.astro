---
import ToolPage from '../../../layouts/ToolPage.astro';

const steps = [
  'Drop in an image, or paste one. Until you do, we show a sample photo so you can see how it works.',
  'Compare the three kinds of placeholder: a tiny blurred image, a BlurHash and a ThumbHash. Press “Simulate slow load” to watch the blur fade into the real image, the way your visitors on a slow phone will see it.',
  'Copy the code for your setup: Next.js <code>&lt;Image&gt;</code>, plain HTML and CSS, or the hash with the library that turns it back into a picture.',
];

const faq = [
  { q: 'Is my image uploaded anywhere?', a: 'No. Everything happens in your browser. Your image never leaves your computer.' },
  { q: 'What is a blur placeholder for?', a: 'Big images take a moment to load. Without a placeholder, visitors see an empty box (or the page jumps when the image arrives). A blur placeholder fills that box at once with a soft version of the picture, so the page feels ready, then the real image fades in on top.' },
  { q: 'Which one should I use?', a: 'Using Next.js? Use the <strong>blurred image</strong> with <code>placeholder="blur"</code>. Anywhere else, the blurred image also works with one line of CSS and needs no library. Pick <strong>BlurHash</strong> or <strong>ThumbHash</strong> when you store placeholders in a database (they’re short text) or build a mobile app. ThumbHash keeps more detail and supports see-through images; BlurHash has libraries for almost every language.' },
  { q: 'Next.js already blurs local images. Do I need this?', a: 'Not for images you <code>import</code> from your project: Next.js makes their placeholder at build time. You need a <code>blurDataURL</code> for images that come from a URL, a CMS or a database, because Next.js can’t see those at build time. That’s what this tool gives you.' },
  { q: 'How big is the placeholder?', a: 'Usually a few hundred bytes, small enough to put straight in your HTML. The “Detail” slider makes it sharper or softer. More detail means a few more bytes.' },
  { q: 'Can my AI coding agent do this for every image?', a: 'Yes. Click “Copy prompt for your AI agent” and paste it into Claude Code, Codex or Cursor. It asks the agent to add blur placeholders across your site, using the <a href="https://plaiceholder.co" rel="noopener">plaiceholder</a> library for images it can read at build time.' },
];
---
<ToolPage
  slug="blur-placeholder-generator"
  title="Blur placeholder generator: blurDataURL, BlurHash and ThumbHash · Darnly"
  description="Drop an image and get a tiny blurred placeholder as a data URI for Next.js blurDataURL or CSS, plus BlurHash and ThumbHash strings. Watch the fade-in on a simulated slow load. Free, and nothing is uploaded."
  h1="Blur placeholders for your images"
  lede="Drop an image and get a soft, blurred version that’s only a few hundred bytes. It shows while the real image loads, so your page never has empty boxes. Copy it for Next.js, CSS, or as a BlurHash or ThumbHash. It runs in your browser, so nothing is uploaded."
  steps={steps}
  faq={faq}
>
  <div class="bp">
    <label class="drop" id="bp-drop">
      <input id="bp-file" type="file" accept="image/*" />
      <strong>Drop your image here</strong>
      <span id="bp-drop-text">or click to choose one, or paste it. Below is a sample until you do.</span>
    </label>
    <p class="error" id="bp-error" role="alert" hidden></p>

    <div class="stage">
      <figure class="panel">
        <div class="frame" id="bp-frame-ph">
          <img id="bp-ph" alt="The placeholder" />
          <span class="badge" id="bp-badge"></span>
        </div>
        <figcaption><strong>Placeholder</strong> <span id="bp-ph-size"></span></figcaption>
      </figure>
      <figure class="panel">
        <div class="frame" id="bp-frame-real">
          <img id="bp-real-ph" class="under" alt="" aria-hidden="true" />
          <img id="bp-real" class="real" alt="Your image" />
          <div class="loading" id="bp-loading" hidden><span>Loading on a slow phone…</span><i id="bp-bar"></i></div>
        </div>
        <figcaption><strong>Your image</strong> <span id="bp-real-size"></span></figcaption>
      </figure>
    </div>

    <div class="verdict" id="bp-verdict" role="status" aria-live="polite"></div>

    <div class="row">
      <button type="button" class="primary" id="bp-play">▶ Simulate slow load</button>
      <label class="detail">Detail
        <input id="bp-detail" type="range" min="4" max="32" step="1" value="10" />
        <output id="bp-detail-out" for="bp-detail">10 px</output>
      </label>
      <button type="button" class="ghost" id="bp-sample" hidden>Show the sample again</button>
    </div>

    <div class="kinds" role="radiogroup" aria-label="Kind of placeholder" id="bp-kinds">
      <button type="button" role="radio" data-kind="blur" aria-checked="true">
        <img data-thumb="blur" alt="" />
        <strong>Blurred image</strong>
        <span>For Next.js and CSS. No library needed.</span>
        <em data-size="blur"></em>
      </button>
      <button type="button" role="radio" data-kind="blurhash" aria-checked="false">
        <img data-thumb="blurhash" alt="" />
        <strong>BlurHash</strong>
        <span>Short text to store in a database. Libraries for every language.</span>
        <em data-size="blurhash"></em>
      </button>
      <button type="button" role="radio" data-kind="thumbhash" aria-checked="false">
        <img data-thumb="thumbhash" alt="" />
        <strong>ThumbHash</strong>
        <span>Like BlurHash with more detail, and it keeps see-through parts.</span>
        <em data-size="thumbhash"></em>
      </button>
    </div>

    <section class="code" aria-labelledby="bp-code-h">
      <h2 id="bp-code-h">Copy it into your project</h2>
      <div class="tabs" role="tablist" id="bp-tabs">
        <button type="button" role="tab" data-tab="next" aria-selected="true">Next.js</button>
        <button type="button" role="tab" data-tab="css" aria-selected="false">HTML &amp; CSS</button>
        <button type="button" role="tab" data-tab="blurhash" aria-selected="false">BlurHash</button>
        <button type="button" role="tab" data-tab="thumbhash" aria-selected="false">ThumbHash</button>
        <button type="button" role="tab" data-tab="uri" aria-selected="false">Data URI only</button>
      </div>
      <p class="hint" id="bp-hint"></p>
      <pre><code id="bp-code"></code></pre>
      <div class="row">
        <button type="button" class="primary" id="bp-copy">Copy code</button>
        <button type="button" class="ghost" id="bp-prompt">Copy prompt for your AI agent</button>
        <span class="said" id="bp-said" role="status" aria-live="polite"></span>
      </div>
    </section>

    <details class="more-info">
      <summary>How this works</summary>
      <p><strong>Blurred image:</strong> we shrink your image to a few pixels wide (the “Detail” setting) and save it as WebP or PNG, whichever is smaller. For Next.js that tiny image is the <code>blurDataURL</code>, and Next.js blurs it for you. For CSS we wrap it in a small SVG with a blur filter, so it looks smooth in any browser without extra code.</p>
      <p><strong>BlurHash</strong> stores the main colors and shapes as a short text string (4×3 parts by default, picked from your image’s shape). It’s encoded with the same maths as Wolt’s reference library. You turn it back into a picture with the <code>blurhash</code> library.</p>
      <p><strong>ThumbHash</strong> does the same with a smarter color model, so it keeps more detail and the image’s shape, and supports see-through images. It matches Evan Wallace’s reference encoder byte for byte. You turn it back into a picture with the <code>thumbhash</code> library.</p>
      <p>Big images are scaled down first, so it stays fast. The sizes shown are for the placeholder text you paste, not the real image.</p>
    </details>
  </div>
</ToolPage>

<script>
  import '../../../scripts/blur-placeholder-generator';
</script>

<style>
  .bp { display: grid; gap: 18px; min-width: 0; }
  .bp [hidden] { display: none !important; }
  .drop { position: relative; display: grid; place-items: center; gap: 6px; text-align: center; padding: 28px 20px; border: 2px dashed var(--line); border-radius: 20px; background: var(--wash); cursor: pointer; }
  .drop:hover, .drop:global(.over) { border-color: var(--sky); }
  .drop input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .drop strong { font: 700 22px/1.2 var(--display); }
  .drop span { color: var(--ink-soft); overflow-wrap: anywhere; }
  .drop:focus-within { outline: 3px solid var(--pink); outline-offset: 3px; }
  .error { margin: 0; color: #B4234F; }

  .stage { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .panel { margin: 0; display: grid; gap: 8px; min-width: 0; }
  .panel figcaption { font-size: 15px; color: var(--ink-soft); }
  .panel figcaption strong { color: var(--ink); }
  .frame { position: relative; overflow: hidden; border-radius: 16px; background: var(--wash); aspect-ratio: var(--ratio, 3 / 2); max-height: 460px; }
  .frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .frame img:not([src]) { visibility: hidden; }
  .frame .real { transition: opacity 0.6s ease; }
  .frame .real:global(.hide) { opacity: 0; transition: none; }
  .badge { position: absolute; left: 12px; top: 12px; padding: 6px 10px; border-radius: 999px; background: rgba(15, 23, 32, 0.72); color: #fff; font: 600 13px/1 var(--mono); }
  .loading { position: absolute; left: 12px; right: 12px; bottom: 12px; display: grid; gap: 6px; padding: 10px 12px; border-radius: 12px; background: rgba(15, 23, 32, 0.72); color: #fff; font-size: 14px; }
  .loading i { display: block; height: 4px; width: 0; border-radius: 4px; background: var(--sky); }

  .verdict { padding: 14px 18px; border-radius: 14px; background: #E5F6EE; color: #0B5A41; font-size: 16px; line-height: 1.45; }
  .verdict:empty { display: none; }

  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; }
  .row button { font: 600 16px/1 var(--body); padding: 14px 20px; border-radius: 999px; cursor: pointer; }
  button.primary { border: 0; background: var(--sky); color: var(--white); }
  button.primary:hover { background: #047FAB; }
  button.ghost { border: 1px solid var(--line); background: var(--white); color: var(--ink); }
  button.ghost:hover { border-color: var(--sky); }
  .detail { display: flex; align-items: center; gap: 8px; font-size: 15px; }
  .detail input { width: 140px; }
  .detail output { font: 500 14px/1 var(--mono); min-width: 3.5em; }
  .detail:global(.off) { opacity: 0.45; }

  .kinds { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .kinds button { display: grid; grid-template-columns: 64px minmax(0, 1fr); grid-template-rows: auto auto auto; column-gap: 12px; row-gap: 2px; align-content: start; text-align: left; padding: 12px; border: 1px solid var(--line); border-radius: 14px; background: var(--white); color: var(--ink); font: inherit; cursor: pointer; }
  .kinds button:hover { border-color: var(--sky); }
  .kinds button[aria-checked='true'] { border-color: var(--ink); box-shadow: inset 0 0 0 1px var(--ink); background: var(--wash); }
  .kinds img { grid-row: 1 / 4; width: 64px; height: 64px; object-fit: cover; border-radius: 10px; background: var(--line); }
  .kinds strong { font: 700 16px/1.2 var(--display); }
  .kinds span { font-size: 13px; line-height: 1.35; color: var(--ink-soft); }
  .kinds em { font: normal 600 12px/1.4 var(--mono); color: #11795A; }

  .code { display: grid; gap: 12px; min-width: 0; }
  .code h2 { margin: 8px 0 0; font: 700 22px/1.2 var(--display); }
  .tabs { display: flex; flex-wrap: wrap; gap: 8px; }
  .tabs button { font: 600 14px/1 var(--body); padding: 10px 14px; border: 1px solid var(--line); border-radius: 999px; background: var(--white); color: var(--ink); cursor: pointer; }
  .tabs button[aria-selected='true'] { background: var(--ink); border-color: var(--ink); color: var(--white); }
  .hint { margin: 0; font-size: 15px; color: var(--ink-soft); }
  .hint :global(code) { font-family: var(--mono); font-size: 0.92em; }
  pre { margin: 0; padding: 16px; border-radius: 14px; background: #0F1720; color: #E6EEF2; overflow: auto; max-height: 320px; font: 13px/1.55 var(--mono); }
  pre code { white-space: pre-wrap; word-break: break-all; }
  .said { font-size: 14px; color: #11795A; }

  .more-info { border-top: 1px solid var(--line); padding-top: 12px; }
  .more-info summary { cursor: pointer; font-weight: 600; }
  .more-info p { color: var(--ink-soft); font-size: 15px; }

  @media (max-width: 720px) {
    .kinds { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 560px) {
    .stage { grid-template-columns: minmax(0, 1fr); }
    .detail input { width: 110px; }
  }
</style>
