---
import ToolPage from '../../../layouts/ToolPage.astro';

const steps = [
  'Paste your site’s address. Google loads it on a mid-range phone and on a laptop, which takes 15 to 40 seconds.',
  'See your score for each, and watch the page load frame by frame, so you can see exactly what visitors stare at while they wait.',
  'Read the three things that matter (how fast the main content appears, whether the page jumps, how fast taps answer) in plain words, then copy one prompt that fixes the top three problems.',
];

const faq = [
  { q: 'Where do the scores come from?', a: 'From Google PageSpeed Insights, the same Lighthouse test Google shows at pagespeed.web.dev. We run it for you on a phone and a laptop and turn the result into plain words and prompts for your AI agent.' },
  { q: 'Why is my phone score so much lower?', a: 'Google tests phones on a slow 4G connection with a mid-range processor, because that’s what many real visitors have. Big images and lots of JavaScript hurt much more there than on your laptop.' },
  { q: 'What are Core Web Vitals?', a: 'Three numbers Google uses to judge how a page feels: Largest Contentful Paint (how long the biggest image or text takes to appear; good is under 2.5 seconds), Cumulative Layout Shift (how much the page jumps while loading; good is under 0.1) and Interaction to Next Paint (how fast taps and clicks answer; good is under 200 ms).' },
  { q: 'Why does the score change each time I test?', a: 'Every test loads your site over a real network, so server speed, ads and third-party scripts vary a little each time. A swing of 5 to 10 points is normal. Results are kept for an hour, so testing again within the hour shows the same result.' },
  { q: 'Can I test a site on localhost?', a: 'No. Google tests from the internet, so the site needs a public address. Deploy a preview (Vercel, Netlify and Cloudflare all make one per branch), then paste that.' },
  { q: 'Is 100 the goal?', a: 'No. Above 90 is great, and 50 to 89 is fine for most sites. Fix the red items first: they’re what visitors actually feel.' },
];
---
<ToolPage
  slug="page-speed-checker"
  title="Page speed checker: why is my site slow? · Darnly"
  description="Free page speed test for phone and desktop. See your Google PageSpeed score, watch your page load frame by frame, read Core Web Vitals in plain words, and copy a prompt that fixes the top three problems."
  h1="Page speed checker: why is my site slow?"
  lede="Paste your site to get phone and laptop scores, watch it load frame by frame, and get the three fixes that matter most, as prompts for your AI agent."
  steps={steps}
  faq={faq}
>
  <div class="ps">
    <form id="ps-form" class="ask">
      <label class="sr" for="ps-url">Website address</label>
      <input id="ps-url" type="text" inputmode="url" autocomplete="url" placeholder="yoursite.com" required />
      <button id="ps-go" type="submit">Test my speed</button>
    </form>
    <p class="error" id="ps-error" role="alert" hidden></p>

    <section class="stage" id="ps-stage" aria-live="polite">
      <p class="eyebrow" id="ps-eyebrow">Example result</p>
      <p class="verdict" id="ps-verdict"></p>
      <div class="devices">
        <button type="button" class="device phone" id="ps-dev-mobile" data-dev="mobile" aria-pressed="true">
          <span class="screen"><img id="ps-shot-mobile" alt="" /></span>
          <span class="gauge" id="ps-gauge-mobile"><b></b><small></small></span>
          <span class="dev-name">Phone</span>
        </button>
        <button type="button" class="device laptop" id="ps-dev-desktop" data-dev="desktop" aria-pressed="false">
          <span class="screen"><img id="ps-shot-desktop" alt="" /></span>
          <span class="base"></span>
          <span class="gauge" id="ps-gauge-desktop"><b></b><small></small></span>
          <span class="dev-name">Laptop</span>
        </button>
      </div>
      <div class="wait" id="ps-wait" hidden>
        <span class="spinner" aria-hidden="true"></span>
        <p id="ps-wait-text">Google is loading your page on a phone and a laptop…</p>
      </div>
    </section>

    <div id="ps-body">
      <section class="block">
        <h2 id="ps-film-h">How it loads on a phone</h2>
        <p class="hint">What a visitor sees while they wait. The highlighted frame is when your main content appears.</p>
        <ol class="film" id="ps-film"></ol>
      </section>

      <section class="block">
        <h2>Core Web Vitals, in plain words</h2>
        <ul class="vitals" id="ps-vitals"></ul>
        <p class="hint" id="ps-field-note"></p>
      </section>

      <section class="block" id="ps-fixes-block">
        <div class="fix-head">
          <h2 id="ps-fixes-h">Top 3 fixes</h2>
          <button id="ps-all" type="button" class="primary">Copy prompt to fix all three</button>
        </div>
        <ol class="fixes" id="ps-fixes"></ol>
        <p class="hint" id="ps-nofix" hidden>Nothing big left to fix. Nice work.</p>
      </section>

      <details class="more">
        <summary>Details: every number Google measured</summary>
        <table class="nums">
          <thead><tr><th scope="col">Measure</th><th scope="col">Phone</th><th scope="col">Laptop</th></tr></thead>
          <tbody id="ps-table"></tbody>
        </table>
        <p class="hint" id="ps-details-note"></p>
      </details>

      <div class="actions">
        <button id="ps-link" type="button" class="ghost">Copy link to this result</button>
        <a class="ghost" id="ps-google" href="https://pagespeed.web.dev/" target="_blank" rel="noopener">Full report on Google</a>
        <p class="status" id="ps-status" role="status" aria-live="polite"></p>
      </div>
    </div>
  </div>
</ToolPage>

<script>
  import '../../../scripts/page-speed-checker';
</script>

<style>
  .ps [hidden] { display: none !important; }
  .ps { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; min-width: 0; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .ask { display: flex; gap: 10px; }
  .ask input { flex: 1; min-width: 0; font: inherit; font-size: 18px; padding: 14px 18px; border: 2px solid var(--line); border-radius: 999px; background: var(--white); }
  .ask input:focus { outline: none; border-color: var(--sky); }
  .ask button { font: 600 16px/1 var(--body); padding: 0 26px; border: 0; border-radius: 999px; background: var(--sky); color: var(--white); cursor: pointer; white-space: nowrap; }
  .ask button:disabled { opacity: 0.6; cursor: wait; }
  .error { margin: 0; color: #B4234F; }

  /* The big preview: a phone and a laptop showing the loaded page, each with its score. */
  .stage { position: relative; display: grid; gap: 14px; padding: 28px; border-radius: 24px; border: 1px solid var(--line); background: var(--wash); overflow: hidden; }
  .eyebrow { margin: 0; font: 700 12px/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft); }
  .verdict { margin: 0; font: 700 26px/1.2 var(--display); letter-spacing: -0.01em; overflow-wrap: anywhere; }
  .devices { display: flex; align-items: flex-end; justify-content: center; gap: 36px; padding-top: 10px; }
  .device { position: relative; display: grid; justify-items: center; gap: 10px; padding: 0; border: 0; background: none; cursor: pointer; color: var(--ink); font: inherit; opacity: 0.55; transition: opacity 0.15s; }
  .device[aria-pressed='true'] { opacity: 1; }
  .device:hover { opacity: 0.9; }
  .device:focus-visible { outline: 3px solid var(--sky); outline-offset: 6px; border-radius: 12px; }
  .screen { display: block; overflow: hidden; background: var(--white); }
  .screen img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .phone .screen { width: 168px; height: 340px; border: 9px solid #0B2230; border-radius: 30px; }
  .laptop .screen { width: 420px; height: 262px; border: 10px solid #0B2230; border-bottom-width: 14px; border-radius: 14px 14px 0 0; }
  .laptop .base { display: block; width: 480px; height: 12px; margin-top: -10px; border-radius: 0 0 14px 14px; background: #3A4C57; }
  .gauge { position: absolute; top: 18px; right: -22px; width: 92px; height: 92px; border-radius: 50%; display: grid; place-content: center; text-align: center; background: conic-gradient(var(--c, #9AA5AD) calc(var(--p, 0) * 1%), #E3E8EB 0); box-shadow: 0 8px 24px rgba(11, 34, 48, 0.18); }
  .gauge::before { content: ''; position: absolute; inset: 9px; border-radius: 50%; background: var(--white); }
  .gauge b, .gauge small { position: relative; }
  .gauge b { font: 800 30px/1 var(--display); color: var(--c, var(--ink)); }
  .gauge small { font: 600 11px/1.2 var(--body); color: var(--ink-soft); }
  .laptop .gauge { right: -10px; }
  .dev-name { font-weight: 600; }
  .gauge.good { --c: #128A4A; }
  .gauge.ok { --c: #C77C00; }
  .gauge.poor { --c: #D2344F; }
  .stage.loading .device { opacity: 0.35; }
  .stage.loading .screen { animation: pulse 1.4s ease-in-out infinite; }
  @keyframes pulse { 50% { filter: brightness(0.9); } }
  .wait { position: absolute; inset: auto 0 0 0; display: flex; gap: 12px; align-items: center; justify-content: center; padding: 14px; background: rgba(255, 255, 255, 0.92); }
  .wait p { margin: 0; font-weight: 600; }
  .spinner { width: 20px; height: 20px; border-radius: 50%; border: 3px solid var(--line); border-top-color: var(--sky); animation: spin 0.8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  #ps-body { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; }
  .block { display: grid; gap: 10px; min-width: 0; }
  .block h2 { margin: 0; font-size: 22px; }
  .hint { margin: 0; color: var(--ink-soft); font-size: 15px; }

  .film { list-style: none; margin: 0; padding: 4px 2px 10px; display: flex; gap: 10px; overflow-x: auto; }
  .film :global(li) { flex: none; display: grid; gap: 6px; justify-items: center; }
  .film :global(img) { display: block; width: 92px; height: 164px; object-fit: cover; object-position: top; border: 2px solid var(--line); border-radius: 10px; background: var(--white); }
  .film.wide :global(img) { width: 150px; height: 100px; }
  .film :global(li.lcp img) { border-color: var(--sky); box-shadow: 0 0 0 3px rgba(5, 147, 198, 0.25); }
  .film :global(span) { font: 600 13px/1 var(--mono); color: var(--ink-soft); }
  .film :global(li.lcp span) { color: var(--sky); }

  .vitals { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
  .vitals :global(li) { display: grid; gap: 8px; align-content: start; padding: 16px 18px; border: 1px solid var(--line); border-top-width: 5px; border-radius: 16px; background: var(--white); }
  .vitals :global(li.good) { border-top-color: #1F9D55; }
  .vitals :global(li.ok) { border-top-color: #E0A100; }
  .vitals :global(li.poor) { border-top-color: #D2344F; }
  .vitals :global(.v-name) { margin: 0; font: 700 12px/1.2 var(--mono); letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-soft); }
  .vitals :global(.v-big) { margin: 0; font: 700 19px/1.3 var(--body); }
  .vitals :global(.v-grade) { justify-self: start; font: 700 12px/1 var(--mono); padding: 6px 9px; border-radius: 999px; }
  .vitals :global(.good .v-grade) { background: #D6F5E3; color: #0B6B3A; }
  .vitals :global(.ok .v-grade) { background: #FFF1CC; color: #7A5300; }
  .vitals :global(.poor .v-grade) { background: #FBE0E8; color: #9C1C44; }

  .fix-head { display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: center; justify-content: space-between; }
  .primary { font: 600 15px/1 var(--body); padding: 12px 18px; border: 0; border-radius: 999px; background: var(--ink); color: var(--white); cursor: pointer; }
  .fixes { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; counter-reset: fix; }
  .fixes :global(li) { counter-increment: fix; display: grid; grid-template-columns: 32px minmax(0, 1fr); gap: 4px 14px; padding: 16px 18px; border: 1px solid var(--line); border-radius: 16px; background: var(--white); }
  .fixes :global(li)::before { content: counter(fix); grid-row: span 4; width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; background: var(--sky); color: var(--white); font: 700 16px/1 var(--body); }
  .fixes :global(.f-title) { margin: 2px 0 0; font: 600 18px/1.3 var(--body); }
  .fixes :global(.f-plain) { margin: 0; color: var(--ink-soft); font-size: 15px; }
  .fixes :global(.f-save) { margin: 0; font-size: 14px; font-weight: 600; color: #0B6B3A; }
  .fixes :global(.f-actions) { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
  .ghost, .fixes :global(.f-actions button), .fixes :global(.f-actions a) { font: 600 14px/1 var(--body); padding: 10px 14px; border-radius: 999px; border: 1px solid var(--line); background: var(--white); color: var(--ink); cursor: pointer; text-decoration: none; }
  .ghost:hover, .fixes :global(.f-actions button:hover), .fixes :global(.f-actions a:hover) { border-color: var(--sky); }

  .more { padding: 4px 20px; border-radius: 16px; background: var(--wash); }
  .more summary { cursor: pointer; font-weight: 600; padding: 12px 0; }
  .more[open] { padding-bottom: 16px; }
  .nums { width: 100%; border-collapse: collapse; font-size: 15px; margin-bottom: 10px; }
  .nums th, .nums td { text-align: left; padding: 8px 6px; border-bottom: 1px solid var(--line); }
  .nums td:not(:first-child), .nums th:not(:first-child) { font-family: var(--mono); white-space: nowrap; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .status { margin: 0; font-size: 14px; color: var(--ink-soft); }

  @media (max-width: 720px) {
    .stage { padding: 20px 16px; }
    .verdict { font-size: 21px; }
    .devices { gap: 14px; }
    .phone .screen { width: 112px; height: 226px; border-width: 6px; border-radius: 20px; }
    .laptop .screen { width: 164px; height: 104px; border-width: 6px; border-bottom-width: 8px; border-radius: 10px 10px 0 0; }
    .laptop .base { width: 186px; height: 8px; margin-top: -8px; }
    .gauge { width: 64px; height: 64px; top: 8px; right: -14px; }
    .gauge::before { inset: 6px; }
    .gauge b { font-size: 21px; }
    .gauge small { display: none; }
    .laptop .gauge { right: 0; top: -12px; }
    .ask { flex-direction: column; }
    .ask button { padding: 14px 26px; }
  }
</style>
