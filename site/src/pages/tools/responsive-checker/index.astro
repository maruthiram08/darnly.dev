---
import ToolPage from '../../../layouts/ToolPage.astro';

const steps = [
  'Paste the address of your page. It needs to be live on the internet, starting with <code>https://</code>.',
  'See it at phone (390 px), tablet (768 px) and desktop (1280 px) widths side by side. Each view is the real page, so you can scroll and click inside it.',
  'Spot something broken? Use “Open at this width” to look closer, then tell your AI coding agent the width and what you see.',
];

const faq = [
  { q: 'Why do some sites show as screenshots?', a: 'Many sites (Google, GitHub, Myntra, banks and most big apps) tell browsers not to show them inside other pages. That’s a safety setting on their side. For those sites we take real screenshots at each width instead, so you can still compare them. You can’t click inside a screenshot, so use “Open at this width” for a closer look.' },
  { q: 'Can I check my site on localhost?', a: 'No. This page runs on the internet, so it can’t see your computer. Deploy your site (a Vercel, Netlify or Cloudflare preview link works), then paste that address.' },
  { q: 'Is this the same as a real phone?', a: 'It shows the page at the same width a phone uses, which is what decides most layout problems. Touch, the on-screen keyboard and the phone’s own browser can still differ, so check on a real phone before you launch.' },
  { q: 'Why these three widths?', a: '390 px is a modern iPhone, 768 px is an iPad held upright, and 1280 px is a common laptop. If a layout works at all three, it usually works in between too.' },
  { q: 'Is anything sent to Darnly?', a: 'Only the address you type. Our server checks whether the site allows being shown in a frame, and takes screenshots if it doesn’t. Live views load straight from your site into your browser.' },
];
---
<ToolPage
  slug="responsive-checker"
  title="Free responsive checker: see your site on phone, tablet and desktop · Darnly"
  description="Paste a URL and see your page at phone, tablet and desktop widths side by side. Free, instant, and it runs in your browser."
  h1="Responsive checker: phone, tablet and desktop at once"
  lede="Paste your page’s address and see it at 390, 768 and 1280 pixels wide, side by side. Scroll and click inside each one, just like the real thing."
  steps={steps}
  faq={faq}
>
  <div class="rc">
    <form class="bar" id="rc-form" novalidate>
      <label class="sr" for="rc-url">Page address</label>
      <input id="rc-url" type="text" inputmode="url" autocomplete="url" spellcheck="false" placeholder="https://your-site.com" />
      <button type="submit" class="primary">Check</button>
    </form>
    <p class="error" id="rc-error" role="alert" hidden></p>

    <div class="result" id="rc-result" hidden>
      <p class="hint" id="rc-hint">
        <span><strong>See a grey or blank box?</strong> That site blocks being shown inside other pages. It isn’t a problem with your layout.</span>
        <button type="button" id="rc-shots" class="rc-open">Show screenshots instead</button>
      </p>

      <div class="views" id="rc-views"></div>
    </div>
  </div>
</ToolPage>

<script>
  import '../../../scripts/responsive-checker';
</script>

<style>
  .rc { display: grid; gap: 20px; }
  .bar { display: flex; gap: 10px; }
  .bar input { flex: 1; min-width: 0; font: inherit; font-size: 16px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--white); color: var(--ink); }
  .bar input:focus { outline: 3px solid var(--pink); outline-offset: 1px; }
  .primary { font: 700 16px/1 var(--body); padding: 0 22px; border: 0; border-radius: 12px; background: var(--sky); color: var(--white); cursor: pointer; }
  .primary:focus-visible { outline: 3px solid var(--pink); outline-offset: 2px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .error { margin: 0; color: #B4234F; }
  .result { display: grid; gap: 16px; }
  .views { display: grid; grid-template-columns: minmax(0, 390fr) minmax(0, 620fr) minmax(0, 900fr); gap: 16px; align-items: start; }
  .hint { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 16px; margin: 0; padding: 14px 16px; border-radius: 12px; background: var(--wash); color: var(--ink-soft); font-size: 15px; }
  .hint[hidden] { display: none; }
  .hint strong { color: var(--ink); }
  :global(.rc-view) { display: grid; gap: 8px; min-width: 0; justify-items: start; }
    :global(.rc-name) { font: 500 12px/1.4 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft); }
  :global(.rc-open) { font: 600 13px/1 var(--body); padding: 7px 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--white); color: var(--ink); cursor: pointer; }
  :global(.rc-open:hover) { border-color: var(--sky); }
  :global(.rc-screen) { width: 100%; position: relative; overflow: hidden; border: 1px solid var(--line); border-radius: 12px; background: #fff; }
  :global(.rc-blocked) { position: absolute; inset: 0; display: grid; align-content: center; gap: 8px; padding: 16px; text-align: center; background: var(--wash); color: var(--ink-soft); font-size: 14px; overflow-wrap: anywhere; }
  :global(.rc-blocked strong) { color: var(--ink); font-size: 15px; }
  :global(.rc-tip) { margin: 0; padding: 10px 12px; border-radius: 10px; background: #FFF4D6; color: #6B4A00; font-size: 14px; }
  :global(.rc-tip[hidden]) { display: none; }
  :global(.rc-shot) { overflow-y: auto; }
  :global(.rc-shot img) { display: block; width: 100%; height: auto; }
  :global(.rc-screen iframe) { position: absolute; top: 0; left: 0; border: 0; transform-origin: 0 0; background: #fff; }
  @media (max-width: 760px) {
    .views { grid-template-columns: minmax(0, 1fr); }
    .bar { flex-direction: column; }
    .primary { padding: 14px 22px; }
  }
</style>
