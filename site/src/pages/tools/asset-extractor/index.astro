---
import ToolPage from '../../../layouts/ToolPage.astro';

const steps = [
  'Paste the address of a website.',
  'We read the page and its stylesheets and list every picture it uses: photos and <code>srcset</code> versions, <code>&lt;picture&gt;</code> sources, CSS backgrounds, inline and linked SVGs, favicons and app icons, and the share image.',
  'Filter by kind, see each picture’s type, size in pixels and file size, then download one, copy its link, or download them all as a ZIP.',
];

const faq = [
  { q: 'How do I download all the images from a website?', a: 'Paste the site’s address above, then click “Download all as ZIP”. You get one ZIP with the pictures sorted into folders: images, SVGs, icons, backgrounds and share images. Pick a filter first to download only that kind.' },
  { q: 'Can I reuse the images I download?', a: 'Only if you have the rights. Pictures on a website usually belong to that site or to a photographer. It’s fine for your own site, for pictures with a free license, or to save a reference for yourself. Ask the owner before you publish someone else’s pictures.' },
  { q: 'How do I get a website’s logo or icons as SVG?', a: 'Pick the SVG filter. Logos and icons drawn right in the page show up there too, and “Copy SVG code” gives you markup you can paste into your project or hand to your AI coding agent.' },
  { q: 'Why is a picture missing?', a: 'Some sites add pictures with JavaScript after the page loads, and some block automated visits. We read the first 8 stylesheets and list up to 200 pictures. If something is missing, try a different page on the same site.' },
  { q: 'Is there a size limit?', a: 'Each picture can be up to 5 MB and each ZIP up to 25 MB. Bigger files are skipped, and we tell you which ones so you can open them on the original site.' },
];
---
<ToolPage
  slug="asset-extractor"
  title="Asset extractor: download images, SVGs and icons from any website · Darnly"
  description="Paste any website to list every image, SVG, icon, CSS background and share image it uses. See the type and size of each, download one, or get them all as a ZIP. Free."
  h1="Asset extractor: download images and icons from a website"
  lede="Paste a site to list every picture it uses, with its type and size. Download one, copy its link, or get them all as a ZIP."
  steps={steps}
  faq={faq}
>
  <div class="ax">
    <form id="ax-form" class="ask">
      <label class="sr" for="ax-url">Website address</label>
      <input id="ax-url" type="text" inputmode="url" autocomplete="url" placeholder="linear.app" required />
      <button id="ax-go" type="submit">Find images</button>
    </form>
    <p class="error" id="ax-error" role="alert" hidden></p>

    <div id="ax-out" class="out" hidden>
      <div class="summary">
        <p id="ax-summary"></p>
        <button id="ax-zip" type="button" class="primary">Download all as ZIP</button>
      </div>
      <div class="filters" id="ax-filters" role="group" aria-label="Show"></div>
      <p class="status" id="ax-status" role="status" hidden></p>
      <div class="grid" id="ax-grid"></div>
      <p class="note" id="ax-note" hidden></p>
      <p class="rights">Only reuse pictures you have the rights to, like your own site’s or ones with a free license.</p>
    </div>
  </div>
</ToolPage>

<script>
  import '../../../scripts/asset-extractor';
</script>

<style>
  .ax { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; }
  .ax :global([hidden]) { display: none !important; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .ask { display: flex; gap: 10px; }
  .ask input { flex: 1; min-width: 0; font: inherit; font-size: 18px; padding: 14px 18px; border: 2px solid var(--line); border-radius: 999px; background: var(--white); }
  .ask input:focus { outline: none; border-color: var(--sky); }
  .ask button { font: 600 16px/1 var(--body); padding: 0 26px; border: 0; border-radius: 999px; background: var(--sky); color: var(--white); cursor: pointer; white-space: nowrap; }
  .ask button:disabled { opacity: 0.6; cursor: wait; }
  .error { margin: 0; color: #B4234F; }

  .out { display: grid; grid-template-columns: minmax(0, 1fr); gap: 18px; }
  .summary { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center; justify-content: space-between; }
  .summary p { margin: 0; font-size: 18px; min-width: 0; overflow-wrap: anywhere; }
  .primary { font: 600 15px/1 var(--body); padding: 12px 18px; border: 0; border-radius: 999px; background: var(--ink); color: var(--white); cursor: pointer; }
  .primary:disabled { opacity: 0.6; cursor: wait; }

  .filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .filters :global(button) { font: 600 14px/1 var(--body); padding: 9px 14px; border-radius: 999px; border: 1px solid var(--line); background: var(--white); color: var(--ink); cursor: pointer; }
  .filters :global(button[aria-pressed='true']) { background: var(--sky); border-color: var(--sky); color: var(--white); }
  .status { margin: 0; font-size: 14px; color: var(--ink-soft); }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px; }
  .grid :global(.card) { border: 1px solid var(--line); border-radius: 16px; background: var(--white); overflow: hidden; display: grid; grid-template-rows: auto 1fr; min-width: 0; }
  .grid :global(.thumb) { aspect-ratio: 4 / 3; display: grid; place-items: center; padding: 12px; background: repeating-conic-gradient(#e6eef2 0 25%, #fff 0 50%) 0 0 / 14px 14px; border-bottom: 1px solid var(--line); }
  .grid :global(.thumb img) { max-width: 100%; max-height: 100%; min-width: 16px; min-height: 16px; object-fit: contain; }
  .grid :global(.thumb .broken) { font-size: 13px; color: var(--ink-soft); text-align: center; }
  .grid :global(.body) { padding: 12px 14px 14px; display: grid; gap: 6px; align-content: start; min-width: 0; }
  .grid :global(.name) { font: 600 14px/1.3 var(--body); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin: 0; }
  .grid :global(.meta) { font: 500 12px/1.4 var(--mono); color: var(--ink-soft); margin: 0; }
  .grid :global(.where) { font-size: 12px; color: var(--ink-soft); margin: 0; }
  .grid :global(.actions) { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
  .grid :global(.actions button), .grid :global(.actions a) { font: 600 13px/1 var(--body); padding: 8px 11px; border-radius: 999px; border: 1px solid var(--line); background: var(--white); color: var(--ink); cursor: pointer; text-decoration: none; }
  .grid :global(.actions button:hover), .grid :global(.actions a:hover) { border-color: var(--sky); }
  .note { margin: 0; font-size: 14px; color: var(--ink-soft); }
  .rights { margin: 0; font-size: 14px; color: var(--ink-soft); }

  @media (max-width: 520px) {
    .ask { flex-direction: column; }
    .ask button { padding: 14px 26px; }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .grid :global(.body) { padding: 10px; }
  }
</style>
