---
import ToolPage from '../../../layouts/ToolPage.astro';
import { TOOLS } from '../../../data/site';

// Link to the other store-listing tools that exist on the site right now.
const storeTools = ['app-icon-generator', 'privacy-policy-generator']
  .map((slug) => TOOLS.find((t) => t.slug === slug))
  .filter((t): t is (typeof TOOLS)[number] => Boolean(t));

const steps = [
  'Drop in 1 to 6 screenshots of your app. Until you do, the preview shows an example app so you can see how it works.',
  'Type a headline under each screenshot and pick a background. The preview updates as you type.',
  'Click “Download all (ZIP)”. You get every screenshot at the exact sizes the App Store and Google Play ask for, ready to upload.',
];

const faq = [
  { q: 'Are my screenshots uploaded anywhere?', a: 'No. Everything is drawn in your browser. Your screenshots never leave your computer.' },
  { q: 'Which sizes are in the ZIP?', a: 'iPhone 6.9" (1320 × 2868), iPhone 6.5" (1284 × 2778), iPad 13" (2064 × 2752) and Google Play phone (1080 × 1920). Each size has its own folder, with your screenshots numbered in order.' },
  { q: 'Do I need every size?', a: 'For the App Store, the 6.9" iPhone set is enough for iPhone apps; Apple scales it down for smaller phones. Add the 6.5" set if App Store Connect asks for it. You only need iPad screenshots if your app runs on iPad. Google Play needs at least 2 phone screenshots.' },
  { q: 'How do I take good screenshots of my app?', a: 'Run your app in the iOS Simulator (pick an iPhone 16 Pro Max or similar) and press Cmd+S, or use the Android emulator’s camera button. With Expo, open the app in the simulator from <code>npx expo start</code>. Screenshots from a real phone work too.' },
  { q: 'Why do my iPad images show a phone?', a: 'If you drop phone screenshots, stretching them onto an iPad would look wrong, so the tool shows the phone on the iPad-sized image instead. Apple wants iPad screenshots that show your app running on an iPad, so take them in an iPad simulator if your app supports iPad.' },
  { q: 'Can I use these for TestFlight or my website?', a: 'Yes. They are plain PNG images, so you can use them anywhere: your landing page, a launch post or a pitch deck.' },
];
---
<ToolPage
  slug="app-store-screenshots"
  title="Free App Store screenshot maker for iPhone, iPad and Google Play · Darnly"
  description="Put your app screenshots in a device frame with a headline and get every App Store and Google Play size in one ZIP. Free, and nothing leaves your browser."
  h1="App Store screenshot maker"
  lede="Drop in your app screenshots, type a headline for each, and download App Store and Google Play images at the exact sizes they ask for. It runs in your browser, so nothing is uploaded."
  steps={steps}
  faq={faq}
>
  <div class="ss" id="ss">
    <div class="stage">
      <div class="stage-head">
        <div class="devices" role="tablist" aria-label="Preview size">
          <button type="button" role="tab" data-device="iphone69" aria-selected="true">iPhone 6.9"</button>
          <button type="button" role="tab" data-device="iphone65" aria-selected="false">iPhone 6.5"</button>
          <button type="button" role="tab" data-device="ipad13" aria-selected="false">iPad 13"</button>
          <button type="button" role="tab" data-device="play" aria-selected="false">Google Play</button>
        </div>
        <p class="verdict" id="ss-verdict" aria-live="polite"></p>
      </div>
      <p class="example" id="ss-example">This is an example app. Drop your own screenshots below to replace it.</p>
      <div class="cards" id="ss-cards" aria-label="Screenshot previews"></div>
    </div>

    <label class="drop" id="ss-drop">
      <input id="ss-file" type="file" accept="image/*" multiple />
      <strong id="ss-drop-title">Drop your app screenshots here</strong>
      <span id="ss-drop-text">1 to 6 images, or click to choose. You can also paste a screenshot.</span>
    </label>
    <p class="error" id="ss-error" role="alert" hidden></p>
    <p class="warn" id="ss-warn" hidden></p>

    <div class="bgs">
      <span class="bgs-label">Background</span>
      <div class="swatches" id="ss-swatches" role="radiogroup" aria-label="Background"></div>
      <label class="custom">Your color <input id="ss-color" type="color" value="#0590C2" /></label>
    </div>

    <div class="actions">
      <button id="ss-download" type="button" class="primary">Download all (ZIP)</button>
      <span class="status" id="ss-status" aria-live="polite"></span>
    </div>

    <details class="more">
      <summary>More options</summary>
      <div class="opts">
        <label>Headline color
          <select id="ss-text">
            <option value="auto">Automatic</option>
            <option value="#ffffff">White</option>
            <option value="#0B1F2A">Dark</option>
          </select>
        </label>
        <label>Headline position
          <select id="ss-pos">
            <option value="top">Above the phone</option>
            <option value="bottom">Below the phone</option>
          </select>
        </label>
        <label>Device frame
          <select id="ss-frame">
            <option value="black">Black</option>
            <option value="silver">Silver</option>
            <option value="none">No frame</option>
          </select>
        </label>
      </div>
    </details>

    <details class="more">
      <summary>Sizes and store rules</summary>
      <table class="sizes">
        <thead><tr><th>Size</th><th>Pixels</th><th>When you need it</th></tr></thead>
        <tbody>
          <tr><td>iPhone 6.9"</td><td>1320 × 2868</td><td>Every iPhone app. Apple scales it down for smaller iPhones.</td></tr>
          <tr><td>iPhone 6.5"</td><td>1284 × 2778</td><td>Only if App Store Connect asks for it.</td></tr>
          <tr><td>iPad 13"</td><td>2064 × 2752</td><td>Only if your app runs on iPad.</td></tr>
          <tr><td>Google Play phone</td><td>1080 × 1920</td><td>Every Android app: at least 2, up to 8.</td></tr>
        </tbody>
      </table>
      <p class="note">The App Store takes up to 10 screenshots per size and Google Play up to 8. The first 3 matter most: they show in search results.</p>
    </details>

    {storeTools.length > 0 && (
      <p class="also">
        Everything for your store listing:{" "}
        {storeTools.map((t, i) => (
          <>{i > 0 && ' and '}<a href={`/tools/${t.slug}/`}>{t.name}</a></>
        ))}.
      </p>
    )}
  </div>
</ToolPage>

<script>
  import '../../../scripts/app-store-screenshots';
</script>

<style>
  .ss { display: grid; gap: 20px; }
  .ss [hidden] { display: none !important; }
  .stage { display: grid; gap: 14px; padding: 20px; border-radius: 24px; background: var(--wash); border: 1px solid var(--line); min-width: 0; }
  .stage-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }
  .devices { display: flex; flex-wrap: wrap; gap: 6px; }
  .devices button { font: 600 14px/1 var(--body); padding: 10px 14px; border-radius: 999px; border: 1px solid var(--line); background: var(--white); color: var(--ink); cursor: pointer; }
  .devices button[aria-selected='true'] { background: var(--ink); border-color: var(--ink); color: var(--white); }
  .verdict { margin: 0; font: 600 14px/1.3 var(--body); color: #0B6B3A; }
  .example { margin: 0; font-size: 14px; color: var(--ink-soft); }
  .cards { display: flex; gap: 16px; overflow-x: auto; padding-bottom: 8px; scroll-snap-type: x proximity; }
  .cards :global(.card) { flex: 0 0 auto; display: grid; gap: 8px; width: 200px; scroll-snap-align: start; }
  .cards :global(.card.wide) { width: 260px; }
  .cards :global(canvas) { width: 100%; height: auto; border-radius: 12px; box-shadow: 0 6px 18px rgba(11, 31, 42, 0.18); background: var(--white); }
  .cards :global(.cap) { width: 100%; box-sizing: border-box; font: 500 14px/1.3 var(--body); padding: 9px 10px; border: 1px solid var(--line); border-radius: 10px; background: var(--white); color: var(--ink); }
  .cards :global(.cap:focus) { outline: 2px solid var(--sky); outline-offset: 1px; }
  .cards :global(.tools) { display: flex; gap: 6px; justify-content: center; }
  .cards :global(.tools button) { font: 600 13px/1 var(--body); padding: 7px 10px; border-radius: 8px; border: 1px solid var(--line); background: var(--white); color: var(--ink); cursor: pointer; }
  .cards :global(.tools button:hover) { border-color: var(--sky); }
  .cards :global(.tools button:disabled) { opacity: 0.35; cursor: default; }
  .drop { position: relative; display: grid; place-items: center; gap: 6px; text-align: center; padding: 32px 24px; border: 2px dashed var(--line); border-radius: 20px; background: var(--wash); cursor: pointer; }
  .drop:hover, .drop:global(.over) { border-color: var(--sky); }
  .drop input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .drop strong { font: 700 20px/1.2 var(--display); }
  .drop span { color: var(--ink-soft); }
  .drop:focus-within { outline: 3px solid var(--pink); outline-offset: 3px; }
  .error { margin: 0; color: #B4234F; }
  .warn { margin: 0; padding: 12px 16px; border-radius: 12px; background: #FFF4DB; color: #6B4A00; font-size: 15px; }
  .bgs { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; }
  .bgs-label { font-weight: 600; }
  .swatches { display: flex; flex-wrap: wrap; gap: 8px; }
  .swatches :global(button) { width: 36px; height: 36px; border-radius: 50%; border: 2px solid var(--white); box-shadow: 0 0 0 1px var(--line); cursor: pointer; padding: 0; }
  .swatches :global(button[aria-checked='true']) { box-shadow: 0 0 0 3px var(--ink); }
  .custom { display: flex; align-items: center; gap: 8px; font-size: 15px; }
  .custom input { width: 40px; height: 32px; border: 1px solid var(--line); border-radius: 8px; padding: 2px; background: var(--white); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .actions button { font: 600 16px/1 var(--body); padding: 15px 22px; border-radius: 999px; cursor: pointer; border: 0; background: var(--sky); color: var(--white); }
  .actions button:hover { background: #047FAB; }
  .actions button:disabled { opacity: 0.6; cursor: wait; }
  .status { font-size: 15px; color: var(--ink-soft); }
  .more summary { cursor: pointer; font-weight: 600; padding: 8px 0; }
  .opts { display: flex; flex-wrap: wrap; gap: 12px 24px; padding: 8px 0; }
  .opts label { display: grid; gap: 6px; font-size: 14px; }
  .opts select { font: 500 15px/1 var(--body); padding: 8px 10px; border-radius: 8px; border: 1px solid var(--line); background: var(--white); color: var(--ink); }
  .sizes { width: 100%; border-collapse: collapse; font-size: 14px; }
  .sizes th, .sizes td { text-align: left; padding: 8px 8px 8px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .sizes td:nth-child(2) { white-space: nowrap; font-family: var(--mono); font-size: 13px; }
  .note { font-size: 14px; color: var(--ink-soft); }
  .also { margin: 0; font-size: 15px; }
  @media (max-width: 600px) {
    .stage { padding: 14px; }
    .cards :global(.card) { width: 160px; }
    .cards :global(.card.wide) { width: 220px; }
  }
</style>
