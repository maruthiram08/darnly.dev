---
// /guides/ hub. Lists every guide in GUIDES; hidden from search (noindex, and left out of the sitemap in astro.config.mjs) while GUIDES is empty.
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { GUIDES } from '../../data/site';
---
<Base title="Guides for vibecoders: fixing bugs with AI · Darnly" description="Plain, short guides for showing Claude Code, Codex and Cursor the bug you see, writing reports agents can fix, and testing your app before launch." noindex={GUIDES.length === 0}>
  <SiteHeader source="guides-hub" />
  <main class="wrap hub">
    <span class="eyebrow">Guides</span>
    <h1>Guides for vibecoders</h1>
    <p class="intro">How to get unstuck when your AI coding agent can't see the problem. New to Darnly? Start with <a href="/what-is-darnly/">What is Darnly?</a></p>
    {GUIDES.length === 0 ? (
      <p class="empty">The first guides are on the way.</p>
    ) : (
      <ul class="cards">
        {GUIDES.map((t) => (
          <li><a href={`/guides/${t.slug}/`}><strong>{t.name}</strong><span>{t.blurb}</span></a></li>
        ))}
      </ul>
    )}
  </main>
  <SiteFooter />
</Base>
<style>
  .hub { padding-block: 64px 96px; }
  h1 { font-size: clamp(34px, 5vw, 52px); line-height: 1.05; margin-top: 12px; }
  .intro { color: var(--ink-soft); max-width: 60ch; margin: 16px 0 0; }
  .intro a { color: var(--sky); font-weight: 600; }
  .empty { margin-top: 32px; color: var(--ink-soft); }
  .cards { list-style: none; padding: 0; margin: 40px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
  .cards a { display: grid; gap: 6px; padding: 22px; border-radius: 16px; background: var(--wash); text-decoration: none; height: 100%; }
  .cards a:hover { outline: 2px solid var(--sky); }
  .cards span { color: var(--ink-soft); font-size: 15px; }
</style>
