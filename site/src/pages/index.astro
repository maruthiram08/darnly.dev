---
// Home page: sells Darnly's bug capture. Markup and styles are unchanged from the old hand-written page.
import Base from '../layouts/Base.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SetupPrompt from '../components/SetupPrompt.astro';
import { MAC_DMG_URL, STORE_URL, TOOLS, storeUrl } from '../data/site';
import '../styles/home.css';

// A few popular free tools for the strip above the footer; any slug that's gone is skipped.
const popular = ['favicon-generator', 'open-graph-checker', 'font-finder', 'image-compressor', 'llms-txt-generator', 'responsive-checker']
  .map((slug) => TOOLS.find((t) => t.slug === slug))
  .filter((t) => t !== undefined);

// Tells search engines and AI assistants what Darnly is, who makes it, and where to get it.
const jsonLd = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Darnly',
    description: 'A free Chrome extension and Mac app that turns a bug you see on screen into context for AI coding agents such as Claude Code, Codex and Cursor.',
    url: 'https://darnly.dev/',
    downloadUrl: STORE_URL,
    installUrl: STORE_URL,
    image: 'https://darnly.dev/og/default.jpg',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Chrome, macOS',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@id': 'https://darnly.dev/#org' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': 'https://darnly.dev/#org',
    name: 'Darnly',
    url: 'https://darnly.dev/',
    logo: 'https://darnly.dev/icon.png',
    email: 'hello@darnly.dev',
    sameAs: [STORE_URL, 'https://x.com/darnlyhq', 'https://github.com/maruthiram08/darnly.dev'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Darnly',
    url: 'https://darnly.dev/',
    publisher: { '@id': 'https://darnly.dev/#org' },
  },
]);
import FixLoopVideo from '../components/FixLoopVideo.astro';
---
<Base
  title="Darnly: Turn on-screen bugs into context for AI agents"
  description="Spot a bug, press a key, click it. Darnly hands your AI coding agent the screenshot, the element and the recent errors, so it can find and fix it."
  ogDescription="Spot a bug, press a key, click it. Your AI coding agent gets everything it needs to fix it."
>
<script slot="head" type="application/ld+json" set:html={jsonLd} />

<header class="hero">
  <div class="stripes" aria-hidden="true"></div>
  <div class="wrap">
    <nav>
      <a class="brand" href="#top"><img src="icon.png" alt="">Darnly</a>
      <div class="nav-links">
        <a href="/setup/">Set up your agent</a>
        <a href="#how">How it works</a>
        <a href="#report">The report</a>
        <a href="#mac">Mac app</a>
        <a href="#privacy">Privacy</a>
        <a href="/tools/">Free tools</a>
      </div>
    </nav>
    <div class="hero-grid" id="top">
      <div>
        <a class="news" href="/changelog/"><b>New in 0.3.1</b> Type /darnly, then "Take a look" when it's fixed →</a>
        <h1>Spot a bug. <em>Point at it.</em> Your agent fixes it.</h1>
        <p class="lede">Press one key, click the broken part, say what you expected. Darnly hands Claude Code, Codex or Cursor the screenshot, the exact element and the recent errors, without breaking your flow.</p>
        <div class="cta cta-labelled">
          <div class="cta-item"><a class="btn btn-primary btn-shimmer" href={storeUrl('home')}>Add to Chrome</a><small>For web apps: localhost or live</small></div>
          <div class="cta-item"><a class="btn btn-ghost" href="#mac">Get the Mac app</a><small>For native apps: Mac, iOS, Android</small></div>
        </div>
        <div class="agents" aria-label="Works with">
          <span>Works with</span><a href="/setup/#claude-code">Claude Code</a><a href="/setup/#codex">Codex</a><a href="/setup/#cursor">Cursor</a><a class="agents-setup" href="#setup">How to set it up ↓</a>
        </div>
      </div>
      <div class="scene" role="img" aria-label="Darnly in action: a broken Save plan button boxed in red, a note saying what was expected, and the agent reporting it fixed.">
        <div class="browser">
          <div class="bar"><i></i><i></i><i></i><span class="url">localhost:3000/plan</span></div>
          <div class="app">
            <div class="app-top"><b class="dot"></b><b>Acme Planner</b></div>
            <div class="app-h">This week</div>
            <div class="cards">
              <div class="card"><b>Write launch post</b><span>Content</span></div>
              <div class="card"><b>Record demo</b><span>Video</span></div>
              <div class="card"><b>Invite testers</b><span>Community</span></div>
            </div>
            <div class="row">
              <div class="target"><span class="tag">button · 103×39</span><span class="fakebtn">Save plan</span></div>
              <span class="fakebtn ghost">Share</span>
              <svg class="cursor" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 2l15 10-7 1.5L8.5 21z" fill="#0B2230" stroke="#FCFFFF" stroke-width="1.6" stroke-linejoin="round"/></svg>
            </div>
            <div class="hint">Click the broken part · Esc to cancel</div>
          </div>
        </div>
        <div class="note">
          <span class="note-label">What did you expect?</span>
          <p>Save plan should be clickable and save my week<span class="caret"></span></p>
          <span class="enter">Enter ↵</span>
        </div>
        <div class="toast"><span class="tick">✓</span><div><b>1 bug fixed. Take a look.</b><span>PlanBar.tsx · removed pointer-events: none</span></div></div>
      </div>
    </div>
  </div>
</header>

<main>
  <section class="band setup" id="setup" aria-labelledby="setup-h">
    <div class="wrap">
      <span class="eyebrow">Set up in two minutes</span>
      <h2 id="setup-h">Connect Darnly to your agent.</h2>
      <p class="intro">Two ways to get bugs to Claude Code, Cursor or Codex. Pick the one that matches where your code lives, or paste one prompt and let your agent set it up for you.</p>
      <div class="ways">
        <a class="way" href="/setup/#without-mcp">
          <span class="n">Without MCP</span>
          <h3>Code on your computer</h3>
          <p>Link your project folder once and click <strong>Set up this project</strong>. Each bug lands in <code>.darnly/inbox/</code> and <code>/darnly</code> fixes them. No account. Cloud project? Copy and paste each bug instead.</p>
          <span class="more-link">No-MCP setup →</span>
        </a>
        <a class="way" href="/setup/#with-mcp">
          <span class="n">With MCP</span>
          <h3>Code in the cloud, or anywhere</h3>
          <p>Sign in with Google and add <code>api.darnly.dev/mcp</code> to your agent once. It fetches your bugs itself. Just type <code>/darnly</code>.</p>
          <span class="more-link">MCP setup →</span>
        </a>
      </div>
      <div class="agent-links" aria-label="Setup steps for each agent">
        <span>Step-by-step for</span>
        <a href="/setup/#claude-code">Claude Code</a>
        <a href="/setup/#cursor">Cursor</a>
        <a href="/setup/#codex">Codex</a>
      </div>
      <h3 class="prompt-h">Or let your agent do it all</h3>
      <SetupPrompt compact />
      <a class="all-tools" href="/setup/">Read the full setup guide →</a>
    </div>
  </section>

  <section class="band" id="how" style="padding-top: 0">
    <div class="wrap">
      <span class="eyebrow">How it works</span>
      <h2>No screenshots to drag. No explaining twice.</h2>
      <p class="intro">Today a bug costs you a screenshot, an app switch, a hunt for the right file and a paragraph of description. With Darnly it is three moves, and you never leave the page. Then one command, and the panel tells you what got fixed.</p>
      <div class="loop">
        <div class="step">
          <span class="n">Step 1</span>
          <h3>Press the key</h3>
          <p><kbd>⌥</kbd> <kbd>⇧</kbd> <kbd>B</kbd> on any page, on localhost or your live site. Windows is coming soon.</p>
        </div>
        <div class="step">
          <span class="n">Step 2</span>
          <h3>Click the broken part</h3>
          <p>A red box follows your cursor. Arrow keys make it bigger or smaller. Esc cancels.</p>
        </div>
        <div class="step">
          <span class="n">Step 3</span>
          <h3>Say what you expected</h3>
          <p>One sentence, then Enter. Got a picture of how it should look? Paste it in too. Capture as many as you like, then carry on testing.</p>
        </div>
      </div>
      <h3 class="loop-h">Then your agent closes the loop</h3>
      <div class="loop">
        <div class="step">
          <span class="n">Step 4</span>
          <h3>Type <code>/darnly</code></h3>
          <p>In Claude Code or Cursor, one command fixes every bug in your project folder and your cloud inbox. In Claude Code, the agent even tells you when new bugs are waiting and offers to fix them.</p>
        </div>
        <div class="step">
          <span class="n">Step 5</span>
          <h3>Answer if it asks</h3>
          <p>If your note is unclear, the agent asks one short question in its own chat. The Darnly panel shows "Your agent is waiting for your input" so you know to go back.</p>
        </div>
        <div class="step">
          <span class="n">Step 6</span>
          <h3>Take a look</h3>
          <p>The panel says "2 bugs fixed. Take a look." with one line on what changed in each, even if it was closed while the agent worked.</p>
        </div>
      </div>
      <FixLoopVideo />
    </div>
  </section>

  <section class="band" id="report" style="padding-top: 0">
    <div class="wrap report">
      <div>
        <span class="eyebrow">What your agent gets</span>
        <h2>The context a screenshot can't carry.</h2>
        <ul>
          <li><span>A screenshot with the element boxed in red and your note written on it.</span></li>
          <li><span>The exact file and component that drew it, on your local project.</span></li>
          <li><span>The element's selector, text, HTML and styles.</span></li>
          <li><span>Console errors and failed requests from the last 60 seconds.</span></li>
          <li><span>Clear rules: fix it, say what changed, ask if the note is vague.</span></li>
        </ul>
      </div>
      <div class="file" role="figure" aria-label="Example bug report">
        <div class="file-head"><span>.darnly/inbox/2026-11-01-0940-save-plan.md</span><span>markdown</span></div>
<pre><span class="k"># Bug on /plan: PlanBar</span>

<span class="p">**Expected:**</span> Save plan should be clickable
and save my week

<span class="k">## Element (the red box)</span>
- selector: `button[data-testid="save-plan"]`
- code: `src/components/PlanBar.tsx:18` <span class="c">(start here)</span>
- drawn by: `PlanPage` &gt; `PlanBar`
- styles: opacity: 0.45; pointer-events: none

<span class="k">## Errors (last 60s)</span>
- console.error: Save failed: plan is undefined

<span class="k">## Failed requests (last 60s)</span>
- POST /api/plan?token=[hidden] 500 (41 ms)</pre>
      </div>
    </div>
  </section>

  <section class="band" id="mac" style="padding-top: 0">
    <div class="wrap report">
      <div>
        <span class="eyebrow">Darnly for Mac</span>
        <h2>Bugs outside the browser, too.</h2>
        <p class="intro">A small menu bar app for Mac apps, the iOS Simulator and the Android Emulator. Same three moves, same inbox, so your agent already knows what to do.</p>
        <ul>
          <li><span>Press <kbd>⌥</kbd> <kbd>⇧</kbd> <kbd>D</kbd> anywhere, click the broken part, type what you expected.</span></li>
          <li><span>The element comes from macOS accessibility: its kind, label and accessibility id (<code>testID</code> in React Native), the best clue to the code.</span></li>
          <li><span>Errors from the last 60 seconds: the Simulator, the Emulator (adb) or the Mac app's own log, secrets hidden.</span></li>
          <li><span>Works on menu bar and notch apps. A welcome screen sets up the folder and permissions on first launch.</span></li>
        </ul>
        <div class="cta">
          <a class="btn btn-primary" href={MAC_DMG_URL}>Download for Mac</a>
        </div>
        <p class="intro">For macOS 14 or later. Open the download, drag Darnly to Applications, and it walks you through the rest. Or with Homebrew: <code>brew install --cask maruthiram08/darnly/darnly</code></p>
      </div>
      <div class="file" role="figure" aria-label="Example bug report from the Mac app">
        <div class="file-head"><span>.darnly/inbox/2026-11-01-0805-popup-gradient.md</span><span>markdown</span></div>
<pre><span class="k"># Bug in Maccy: group "Clipboard history"</span>

<span class="p">**Expected:**</span> Popup background should use the
brand gradient

<span class="p">**What it should look like:**</span> .reference.png
<span class="c">(a picture you pasted into the note)</span>

<span class="k">## Element (the red box)</span>
- kind: group (`AXGroup`)
- accessibility id: `historyList` <span class="c">(start here)</span>
- size: 450x312 at (0, 52) in the window

<span class="k">## Errors (last 60s)</span>
No errors in the app's log in the last 60 seconds.</pre>
      </div>
    </div>
  </section>

  <section class="band" id="privacy" style="padding-top: 0">
    <div class="wrap">
      <div class="privacy">
        <div>
          <span class="eyebrow">Private by default</span>
          <h2>Your bugs never leave your computer.</h2>
        </div>
        <dl>
          <div><dt>No account needed</dt><dd>Reports are files in your project, or text you choose to paste. Nothing is sent to us unless you switch on the optional cloud inbox for agents that can't see your files.</dd></div>
          <div><dt>Secrets hidden automatically</dt><dd>Passwords, card numbers, tokens, API keys and cookies become [hidden] before anything is saved.</dd></div>
          <div><dt>You choose the sites</dt><dd>Errors are recorded on localhost. Live sites only when you switch them on, one at a time.</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="wrap" aria-label="About the name">
    <div class="name">
      <span class="word">darn·ly</span>
      <p><strong>"Darn it"</strong> is what you say when you spot the bug. <strong>Darning</strong> is how you mend the hole. Darnly sits between the two.</p>
    </div>
  </section>

  {popular.length > 0 && (
    <section class="band tools-strip" id="tools" aria-labelledby="tools-h">
      <div class="wrap">
        <span class="eyebrow">Free tools</span>
        <h2 id="tools-h">{TOOLS.length} free tools for building with AI.</h2>
        <p class="intro">Favicons, share previews, fonts, colors, launch checks and more. No sign-up, and most run right in your browser.</p>
        <ul class="tool-links">
          {popular.map((t) => <li><a href={`/tools/${t.slug}/`}><strong>{t.name}</strong><span>{t.blurb}</span></a></li>)}
        </ul>
        <a class="all-tools" href="/tools/">See all {TOOLS.length} free tools →</a>
      </div>
    </section>
  )}

  <section class="final" id="install">
    <div class="wrap">
      <div class="box">
        <span class="eyebrow" style="color: var(--white)">Live on the Chrome Web Store</span>
        <h2>Try it on your next bug.</h2>
        <p>Darnly is free and works in Chrome, Edge, Brave and Arc. Questions or feedback? Write to hello@darnly.dev.</p>
        <div class="cta">
          <a class="btn btn-primary" href={storeUrl('home')}>Add to Chrome</a>
          <a class="btn btn-ghost" href="https://x.com/darnlyhq"><svg class="x-logo" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>Follow @darnlyhq</a>
        </div>
      </div>
    </div>
  </section>
</main>


<SiteFooter />
</Base>
