---
// The footer on every page: tool categories with their top tools, a link to all tools, and guides once there are any.
import { TOOLS, GUIDES, toolsByCategory, categoryHref } from '../data/site';
const PER_CATEGORY = 4;
const groups = toolsByCategory();
---
<footer>
  <div class="wrap">
    {(TOOLS.length > 0 || GUIDES.length > 0) && (
      <nav class="lists" aria-label="Free tools and guides">
        {TOOLS.length > 0 && (
          <div class="tools">
            <div class="tools-head">
              <h2>Free tools</h2>
              <a href="/tools/">See all {TOOLS.length} tools</a>
            </div>
            <div class="cats">
              {groups.map((g) => (
                <div>
                  <h3>{categoryHref(g.name) ? <a href={categoryHref(g.name)}>{g.name}</a> : g.name}</h3>
                  <ul>
                    {g.tools.slice(0, PER_CATEGORY).map((t) => <li><a href={`/tools/${t.slug}/`}>{t.name}</a></li>)}
                    {g.tools.length > PER_CATEGORY && <li><a class="more" href={categoryHref(g.name) ?? '/tools/'}>+{g.tools.length - PER_CATEGORY} more</a></li>}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        )}
        {GUIDES.length > 0 && (
          <div class="guides">
            <h2>Guides</h2>
            <ul>{GUIDES.map((g) => <li><a href={`/guides/${g.slug}/`}>{g.name}</a></li>)}</ul>
          </div>
        )}
      </nav>
    )}
    <span>© 2026 Darnly. Made for people who build with AI coding agents.</span>
    <span><a href="/privacy">Privacy policy</a></span>
    {/* LaunchIgniter asks for this badge on the site before it gives a free launch slot. */}
    <a class="badge" href="https://launchigniter.com/product/darnly?ref=badge-darnly" target="_blank" rel="noopener">
      <img src="https://launchigniter.com/api/badge/darnly?theme=light" alt="Featured on LaunchIgniter" width="212" height="55" loading="lazy" />
    </a>
  </div>
</footer>
