---
// The footer on every page: tool categories with their top tools, a link to all tools, and guides once there are any.
import { TOOLS, GUIDES, toolsByCategory, categoryHref } from '../data/site';
import CategoryIcon from './CategoryIcon.astro';
const groups = toolsByCategory();
// One pair of rules per tab: show its panel and highlight its label when its radio is checked.
const TAB_CSS = groups.map((_, i) =>
  `#fcat-${i}:checked ~ .panel[data-i="${i}"]{display:block}` +
  `#fcat-${i}:checked ~ .tab-row .tab[data-i="${i}"]{background:var(--ink);color:var(--white)}` +
  `#fcat-${i}:checked ~ .tab-row .tab[data-i="${i}"] .count{color:rgba(255,255,255,.7)}` +
  `#fcat-${i}:focus-visible ~ .tab-row .tab[data-i="${i}"]{outline:3px solid var(--pink);outline-offset:2px}`
).join('');
// Launch-site badges. Add new ones at the end; w/h are the image's own size (only the ratio matters, the CSS sets the height).
const BADGES = [
  // LaunchIgniter asks for this badge on the site before it gives a free launch slot.
  { href: 'https://launchigniter.com/product/darnly?ref=badge-darnly', img: 'https://launchigniter.com/api/badge/darnly?theme=light', alt: 'Featured on LaunchIgniter', w: 212, h: 55 },
  // Uneed's "Launching soon" badge.
  { href: 'https://www.uneed.best/tool/darnly', img: 'https://www.uneed.best/EMBED3B.png', alt: 'Launching Soon on Uneed', w: 250, h: 54 },
  // PeerPush gives a small ranking boost ("Verified") to products whose site links back to their page.
  { href: 'https://peerpush.com/p/darnly', img: 'https://peerpush.com/p/darnly/badge.png', alt: 'Darnly on PeerPush', w: 230, h: 65 },
  // LaunchNest gives a free listing when its badge is on the site.
  { href: 'https://launchnest.io/p/darnly-turn-on-screen-bugs-into-context-for-ai-agents', img: 'https://launchnest.io/badge/darnly-turn-on-screen-bugs-into-context-for-ai-agents.svg?variant=featured', alt: 'Darnly on LaunchNest', w: 220, h: 56 },
];
---
<footer>
  <div class="wrap">
    {(TOOLS.length > 0 || GUIDES.length > 0) && (
      <nav class="lists" aria-label="Free tools and guides">
        {TOOLS.length > 0 && (
          <div class="tools">
            <div class="tools-head">
              <h2>Free tools</h2>
              <a href="/tools/">See all {TOOLS.length} tools</a>
            </div>
            {/* Category tabs (pure CSS radio tabs, no JS): pick a category and every tool in it shows below in columns.
                All links stay in the HTML. Rules that show the picked panel are generated in TAB_CSS. */}
            <div class="cat-tabs">
              {groups.map((g, i) => <input type="radio" name="footer-cat" id={`fcat-${i}`} class="sr-radio" checked={i === 0} />)}
              <div class="tab-row" role="presentation">
                {groups.map((g, i) => (
                  <label for={`fcat-${i}`} class="tab" data-i={i}><CategoryIcon name={g.name} size={16} />{g.name}<span class="count">{g.tools.length}</span></label>
                ))}
              </div>
              {groups.map((g, i) => (
                <div class="panel" data-i={i}>
                  <h3 class="sr">{g.name}</h3>
                  <ul>{g.tools.map((t) => <li><a href={`/tools/${t.slug}/`}>{t.name}</a></li>)}</ul>
                  <a class="more" href={categoryHref(g.name) ?? '/tools/'}>Open the {g.name} page →</a>
                </div>
              ))}
              <style is:inline set:html={TAB_CSS}></style>
            </div>
          </div>
        )}
        {GUIDES.length > 0 && (
          <div class="guides">
            <h2>Guides</h2>
            <ul>{GUIDES.map((g) => <li><a href={`/guides/${g.slug}/`}>{g.name}</a></li>)}</ul>
          </div>
        )}
      </nav>
    )}
    {/* "Featured on" strip: every badge is shown at the same height, so a new one is just a new line in BADGES. */}
    <section class="featured" aria-label="Darnly is featured on">
      <span class="featured-label">Featured on</span>
      <ul class="badges">
        {BADGES.map((b) => (
          <li><a class="badge" href={b.href} target="_blank" rel="noopener"><img src={b.img} alt={b.alt} width={b.w} height={b.h} loading="lazy" /></a></li>
        ))}
      </ul>
    </section>
    <div class="legal">
      <span>© 2026 Darnly. Made for people who build with AI coding agents.</span>
      <a href="/privacy">Privacy policy</a>
    </div>
  </div>
</footer>
