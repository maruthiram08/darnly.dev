---
// The footer on every page: tool categories with their top tools, a link to all tools, and guides once there are any.
import { TOOLS, GUIDES, toolsByCategory, categoryHref } from '../data/site';
const PER_CATEGORY = 4;
const groups = toolsByCategory();
// Launch-site badges. Add new ones at the end; w/h are the image's own size (only the ratio matters, the CSS sets the height).
const BADGES = [
  // LaunchIgniter asks for this badge on the site before it gives a free launch slot.
  { href: 'https://launchigniter.com/product/darnly?ref=badge-darnly', img: 'https://launchigniter.com/api/badge/darnly?theme=light', alt: 'Featured on LaunchIgniter', w: 212, h: 55 },
  // Uneed's "Launching soon" badge.
  { href: 'https://www.uneed.best/tool/darnly', img: 'https://www.uneed.best/EMBED3B.png', alt: 'Launching Soon on Uneed', w: 250, h: 54 },
  // PeerPush gives a small ranking boost ("Verified") to products whose site links back to their page.
  { href: 'https://peerpush.com/p/darnly', img: 'https://peerpush.com/p/darnly/badge.png', alt: 'Darnly on PeerPush', w: 230, h: 65 },
];
---
<footer>
  <div class="wrap">
    {(TOOLS.length > 0 || GUIDES.length > 0) && (
      <nav class="lists" aria-label="Free tools and guides">
        {TOOLS.length > 0 && (
          <div class="tools">
            <div class="tools-head">
              <h2>Free tools</h2>
              <a href="/tools/">See all {TOOLS.length} tools</a>
            </div>
            <div class="cats">
              {groups.map((g) => (
                <div>
                  <h3>{categoryHref(g.name) ? <a href={categoryHref(g.name)}>{g.name}</a> : g.name}</h3>
                  <ul>
                    {g.tools.slice(0, PER_CATEGORY).map((t) => <li><a href={`/tools/${t.slug}/`}>{t.name}</a></li>)}
                    {g.tools.length > PER_CATEGORY && <li><a class="more" href={categoryHref(g.name) ?? '/tools/'}>+{g.tools.length - PER_CATEGORY} more</a></li>}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        )}
        {GUIDES.length > 0 && (
          <div class="guides">
            <h2>Guides</h2>
            <ul>{GUIDES.map((g) => <li><a href={`/guides/${g.slug}/`}>{g.name}</a></li>)}</ul>
          </div>
        )}
      </nav>
    )}
    {/* "Featured on" strip: every badge is shown at the same height, so a new one is just a new line in BADGES. */}
    <section class="featured" aria-label="Darnly is featured on">
      <span class="featured-label">Featured on</span>
      <ul class="badges">
        {BADGES.map((b) => (
          <li><a class="badge" href={b.href} target="_blank" rel="noopener"><img src={b.img} alt={b.alt} width={b.w} height={b.h} loading="lazy" /></a></li>
        ))}
      </ul>
    </section>
    <div class="legal">
      <span>© 2026 Darnly. Made for people who build with AI coding agents.</span>
      <a href="/privacy">Privacy policy</a>
    </div>
  </div>
</footer>
