---
// Home hero picture: the whole Darnly loop in one image.
// 1. You point at the broken part. 2. Darnly hands your agent the context. 3. Your agent fixes it and tells you.
// Drawn in HTML so it stays sharp. Plays once on load (CSS only); with reduced motion it shows the final state.
---
<div class="loop-scene" role="img" aria-label="The Darnly loop: you point at a broken Save plan button, Darnly hands your coding agent the screenshot, element, file and error, and the agent fixes it and tells you 1 bug fixed.">
  <div class="ls-browser ls-s1">
    <span class="ls-step"><b>1</b> You point at it</span>
    <div class="ls-bar"><i></i><i></i><i></i><span>acme-planner.app/plan</span></div>
    <div class="ls-app">
      <div class="ls-h">This week</div>
      <div class="ls-tasks"><span>Write launch post</span><span>Record demo</span></div>
      <div class="ls-row">
        <span class="ls-target"><span class="ls-tag">button · Save plan</span><span class="ls-btn">Save plan</span></span>
        <span class="ls-btn ls-ghost">Share</span>
        <svg class="ls-cursor" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 2l15 10-7 1.5L8.5 21z" fill="#0B2230" stroke="#FCFFFF" stroke-width="1.6" stroke-linejoin="round"/></svg>
      </div>
      <p class="ls-note">“Save plan should save my week”</p>
    </div>
  </div>

  <div class="ls-handoff ls-s2">
    <span class="ls-step"><b>2</b> Darnly hands your agent the context</span>
    <div class="ls-chips">
      <span>📷 Screenshot</span>
      <span>&lt;button&gt; PlanBar.tsx:42</span>
      <span>⚠ 1 console error</span>
      <span>“should save my week”</span>
    </div>
  </div>

  <div class="ls-term ls-s3">
    <span class="ls-step"><b>3</b> Your agent fixes it</span>
    <div class="ls-tbar"><i></i><i></i><i></i><span>Claude Code · acme-planner</span></div>
    <div class="ls-code">
      <p class="ls-l"><span class="ls-p">&gt;</span> /darnly</p>
      <p class="ls-l"><span class="ls-dot">●</span> 1 bug from Darnly: Save plan · PlanBar.tsx:42</p>
      <p class="ls-l ls-del">- &lt;button className="pointer-events-none"&gt;</p>
      <p class="ls-l ls-add">+ &lt;button onClick=&#123;savePlan&#125;&gt;</p>
      <p class="ls-l ls-ok">✓ Fixed. Marked done in Darnly.</p>
    </div>
  </div>

  <div class="ls-toast ls-s4"><span class="ls-tick">✓</span><div><b>1 bug fixed. Take a look.</b><span>Back to you, in your browser</span></div></div>
</div>

<style>
  .loop-scene { position: relative; display: flex; flex-direction: column; padding: 44px 0 8px; min-width: 0; color: var(--ink); }
  .ls-step { position: absolute; top: -13px; left: 16px; z-index: 2; display: inline-flex; align-items: center; gap: 7px; padding: 4px 11px 4px 4px; border-radius: 999px; background: var(--ink); color: #fff; font: 600 12.5px/1.2 var(--body); white-space: nowrap; box-shadow: 0 6px 16px rgba(11, 34, 48, 0.3); }
  .ls-step b { display: grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; background: var(--pink); font-size: 11.5px; }

  .ls-browser > .ls-step, .ls-term > .ls-step { top: -30px; left: 10px; }

  /* 1. Browser */
  .ls-browser { position: relative; width: 82%; background: var(--white); border-radius: 14px; box-shadow: 0 26px 70px rgba(11, 34, 48, 0.35); transform: rotate(-2deg); }
  .ls-bar, .ls-tbar { display: flex; align-items: center; gap: 6px; padding: 9px 12px; border-radius: 14px 14px 0 0; }
  .ls-bar { background: #E9F4F8; }
  .ls-bar i, .ls-tbar i { width: 9px; height: 9px; border-radius: 50%; background: #C5DCE5; }
  .ls-bar span { margin-left: 8px; font: 500 11px/1 var(--mono); color: var(--ink-soft); background: var(--white); padding: 5px 10px; border-radius: 999px; }
  .ls-app { padding: 14px 18px 16px; background: #F6FAFC; border-radius: 0 0 14px 14px; }
  .ls-h { font: 700 19px/1.2 var(--display); }
  .ls-tasks { display: flex; gap: 8px; margin: 10px 0 26px; }
  .ls-tasks span { flex: 1; min-width: 0; font-size: 12.5px; background: var(--white); border-radius: 8px; padding: 9px 10px; box-shadow: 0 1px 3px rgba(11, 34, 48, 0.07); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ls-row { position: relative; display: flex; gap: 10px; align-items: center; }
  .ls-btn { display: inline-block; font-size: 13px; padding: 8px 14px; border-radius: 8px; background: #7C83F0; color: #fff; opacity: 0.5; }
  .ls-ghost { background: var(--white); color: var(--ink); opacity: 1; border: 1px solid var(--line); }
  .ls-target { position: relative; padding: 3px; border: 2.5px solid #E11D48; border-radius: 4px; background: rgba(225, 29, 72, 0.08); }
  .ls-tag { position: absolute; left: -2px; top: -21px; font: 600 10.5px/1.6 var(--body); color: #fff; background: #E11D48; padding: 0 6px; border-radius: 3px; white-space: nowrap; }
  .ls-cursor { position: absolute; width: 22px; height: 22px; left: 60px; top: 20px; }
  .ls-note { margin: 14px 0 0; font-size: 13px; color: var(--ink-soft); font-style: italic; }

  /* 2. Handoff: the context Darnly sends */
  .ls-handoff { position: relative; z-index: 3; align-self: center; width: 88%; margin: 2px 0 0; padding: 20px 14px 14px; border-radius: 14px; background: var(--pink); box-shadow: 0 18px 44px rgba(120, 20, 80, 0.4); transform: rotate(1deg); }
  .ls-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .ls-chips span { font: 500 11.5px/1.3 var(--mono); color: var(--ink); background: var(--white); padding: 5px 9px; border-radius: 7px; white-space: nowrap; }

  /* 3. Agent terminal */
  .ls-term { position: relative; align-self: flex-end; width: 90%; margin-top: 40px; background: #0B2230; color: #DCEBF2; border-radius: 14px; box-shadow: 0 26px 70px rgba(11, 34, 48, 0.45); transform: rotate(-0.5deg); }
  .ls-tbar { background: #132F40; }
  .ls-tbar i { background: #2A4D60; }
  .ls-tbar span { margin-left: 8px; font: 500 11px/1 var(--mono); color: #8FB3C4; }
  .ls-code { padding: 22px 16px 16px; display: grid; gap: 5px; }
  .ls-l { margin: 0; font: 500 12px/1.5 var(--mono); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ls-p { color: var(--pink); }
  .ls-dot { color: #5CC8F0; }
  .ls-del { color: #FF9AAE; background: rgba(225, 29, 72, 0.16); border-radius: 4px; padding: 0 6px; }
  .ls-add { color: #8AF0B8; background: rgba(7, 148, 85, 0.22); border-radius: 4px; padding: 0 6px; }
  .ls-ok { color: #8AF0B8; font-weight: 700; }

  /* 4. Back to you */
  .ls-toast { position: absolute; right: -10px; top: 6px; z-index: 4; display: flex; gap: 10px; align-items: center; background: var(--white); border-radius: 14px; padding: 10px 14px; box-shadow: 0 16px 40px rgba(11, 34, 48, 0.3); font-size: 13px; }
  .ls-toast div { display: grid; }
  .ls-toast span:not(.ls-tick) { color: var(--ink-soft); font-size: 11.5px; }
  .ls-tick { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: #079455; color: #fff; font-weight: 700; flex: none; }

  @media (max-width: 860px) {
    .ls-browser { width: 92%; transform: none; }
    .ls-handoff, .ls-term { transform: none; }
    .ls-handoff { width: 96%; }
    .ls-term { width: 100%; }
    .ls-toast { right: 0; top: -6px; }
  }
  @media (max-width: 420px) {
    .ls-toast span:not(.ls-tick) { display: none; }
    .ls-l { font-size: 11px; }
  }

  /* Plays once on load, step by step; the end state is the static picture. */
  @media (prefers-reduced-motion: no-preference) {
    .ls-s1, .ls-s2, .ls-s3, .ls-s4 { animation: ls-in 0.6s cubic-bezier(.2, .8, .3, 1) both; }
    .ls-s1 { animation-delay: 0.2s; }
    .ls-target { animation: ls-box 0.35s ease 0.9s both; }
    .ls-s2 { animation-delay: 1.5s; }
    .ls-s3 { animation-delay: 2.4s; }
    .ls-l { animation: ls-line 0.3s ease both; }
    .ls-l:nth-child(1) { animation-delay: 2.9s; }
    .ls-l:nth-child(2) { animation-delay: 3.4s; }
    .ls-l:nth-child(3) { animation-delay: 3.9s; }
    .ls-l:nth-child(4) { animation-delay: 4.2s; }
    .ls-l:nth-child(5) { animation-delay: 4.7s; }
    .ls-s4 { animation-name: ls-pop; animation-delay: 5.2s; }
  }
  @keyframes ls-in { from { opacity: 0; translate: 0 22px; } to { opacity: 1; translate: 0 0; } }
  @keyframes ls-box { from { border-color: transparent; background: transparent; } }
  @keyframes ls-line { from { opacity: 0; translate: -6px 0; } }
  @keyframes ls-pop { from { opacity: 0; translate: 0 -12px; scale: 0.92; } to { opacity: 1; translate: 0 0; scale: 1; } }
</style>
