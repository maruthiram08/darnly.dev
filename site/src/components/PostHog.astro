---
// PostHog page views and clicks, added to every page by Base.astro once POSTHOG_KEY is set.
// - No cookies: PostHog keeps its visitor id in localStorage on darnly.dev only, which session
//   replays need (PostHog's fully cookieless mode can't record sessions).
// - Session replays hide everything typed into inputs (URLs pasted into the free tools too).
// - Loaded after the page is idle, from this site's own /_astro/ files, and sent to /ingest/
//   on darnly.dev (the Worker passes it to PostHog). So it doesn't slow the first paint, the
//   CSP stays 'self', and ad blockers that block posthog.com don't hide visitors.
// - Only runs on darnly.dev itself, not on localhost or pull request previews.
// - Named events for the clicks that matter: cta_click { cta: chrome_store | mac_download | brew_copy, location, path, page_type }.
---
<script>
  import { POSTHOG_KEY, POSTHOG_REGION } from '../data/analytics';

  type Props = Record<string, string>;
  type PH = { capture: (event: string, props?: Props, opts?: { transport?: 'XHR' | 'fetch' | 'sendBeacon' }) => void };

  const live = location.hostname === 'darnly.dev' || location.hostname === 'www.darnly.dev';
  if (POSTHOG_KEY && live) {
    let ph: PH | null = null;
    const waiting: [string, Props][] = [];
    const send = (event: string, props: Props) => {
      // sendBeacon so a click that leaves the page (Chrome store, DMG download) still arrives.
      if (ph) ph.capture(event, props, { transport: 'sendBeacon' });
      else waiting.push([event, props]);
    };

    // Where on the page a click came from, for comparing buttons: a data-cta-at tag first
    // (guide-inline, guide-text, guide-strip, tool-note, tool-strip, tool-panel, header, tools-hub),
    // then the home page's section ids (hero, mac, why...).
    const where = (el: Element) => el.closest('[data-cta-at]')?.getAttribute('data-cta-at') || el.closest('section[id], header, footer, nav')?.id || el.closest('header, footer, nav')?.tagName.toLowerCase() || '';

    // Which kind of page drove the click, for the funnel: home, guide, tool, tools-hub or other.
    const pageType = () => {
      const p = location.pathname;
      if (p === '/') return 'home';
      if (p === '/tools/') return 'tools-hub';
      if (p.startsWith('/tools/')) return 'tool';
      if (p.startsWith('/guides/') && p !== '/guides/') return 'guide';
      return 'other';
    };

    document.addEventListener('click', (e) => {
      const el = (e.target as Element | null)?.closest?.('a, button');
      if (!el) return;
      const href = el instanceof HTMLAnchorElement ? el.href : '';
      let cta = '';
      if (href.includes('chromewebstore.google.com/detail/darnly')) cta = 'chrome_store';
      else if (href.endsWith('/Darnly.dmg')) cta = 'mac_download';
      else if (el.hasAttribute('data-copy-brew')) cta = 'brew_copy';
      if (cta) send('cta_click', { cta, location: where(el), path: location.pathname, page_type: pageType() });
    }, { capture: true });

    const start = () => {
      import('posthog-js').then(({ default: posthog }) => {
        posthog.init(POSTHOG_KEY, {
          api_host: '/ingest',
          ui_host: `https://${POSTHOG_REGION}.posthog.com`,
          defaults: '2026-08-30',
          persistence: 'localStorage',
          person_profiles: 'identified_only',
          capture_pageview: true,
          capture_pageleave: true,
          autocapture: true,
          // Replays: only after PostHog's "Record user sessions" is switched on in the project.
          // Typed text is never recorded.
          disable_session_recording: false,
          session_recording: { maskAllInputs: true },
          // Off until we choose to use them: each loads more code.
          disable_surveys: true,
          capture_exceptions: false,
        });
        ph = posthog as unknown as PH;
        for (const [event, props] of waiting.splice(0)) ph.capture(event, props);
      }).catch(() => {});
    };
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 4000 });
    else setTimeout(start, 2000);
  }
</script>
