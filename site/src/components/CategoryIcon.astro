---
// Small line icon for a tool category. Unknown categories get a generic grid.
interface Props { name: string; size?: number }
const { name, size = 22 } = Astro.props;
const paths: Record<string, string> = {
  Design: 'M12 3a9 9 0 0 0 0 18c1.1 0 1.6-.8 1.6-1.6 0-.5-.2-.8-.4-1.1-.3-.3-.4-.7-.4-1.1 0-.9.7-1.6 1.6-1.6H16a5 5 0 0 0 5-5c0-4.1-4-7.6-9-7.6Z M7.5 11.5h.01 M10.5 7.5h.01 M15 8.5h.01',
  Images: 'M4 5h16v14H4z M4 16l5-5 4 4 2-2 5 5 M15.5 9.5h.01',
  'SEO & sharing': 'M11 4a7 7 0 1 0 0 14a7 7 0 0 0 0-14Z M20 20l-4-4',
  'Launch & domains': 'M12 3a9 9 0 1 0 0 18a9 9 0 0 0 0-18Z M3 12h18 M12 3c2.5 2.5 3.8 5.5 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.5-3.8-9S9.5 5.5 12 3Z',
  'Code helpers': 'M8 7l-5 5 5 5 M16 7l5 5-5 5 M14 4l-4 16',
  Security: 'M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6l7-3Z M9 12l2 2 4-4',
};
const d = paths[name] ?? 'M4 4h7v7H4z M13 4h7v7h-7z M4 13h7v7H4z M13 13h7v7h-7z';
---
<svg class="cat-icon" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={d} /></svg>
