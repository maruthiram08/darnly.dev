{
  "manifest_version": 3,
  "name": "Darnly folder write test",
  "version": "0.0.1",
  "description": "Day-one test: can the extension write capture files into a project folder and keep access after a restart?",
  "permissions": ["sidePanel", "storage", "offscreen"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "Open folder write test" },
  "commands": {
    "write-test-capture": {
      "suggested_key": { "default": "Alt+Shift+B", "mac": "Alt+Shift+B" },
      "description": "Write a test capture"
    }
  }
}
